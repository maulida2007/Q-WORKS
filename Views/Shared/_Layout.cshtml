@inject IAuthService AuthService
@{
    var currentUser = AuthService.GetCurrentUser();
    var toastMessage = TempData["ToastMessage"] as string;
    var toastType = TempData["ToastType"] as string ?? "success";
}
<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>@(ViewData["Title"] ?? "Q-WORKS") - Quality Control & Overtime System</title>
  
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%2338bdf8' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z'/></svg>" />

  <!-- Offline Fonts (Inter, Outfit, JetBrains Mono) -->
  <link rel="stylesheet" href="~/css/fonts.css" asp-append-version="true" />
  
  <!-- Core Design System Stylesheet -->
  <link rel="stylesheet" href="~/css/index.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/css/slicer.css" asp-append-version="true" />
</head>
<body>
  @if (currentUser == null)
  {
      <!-- Unauthenticated View (Login) -->
      <div class="app-container auth-wrapper">
        @RenderBody()
        
        @if (!string.IsNullOrEmpty(toastMessage))
        {
            <div class="toast-container" id="toastAlert">
              <div class="toast-box" style="border-left-color: @(toastType == "success" ? "var(--accent-green)" : toastType == "warning" ? "var(--accent-yellow)" : toastType == "danger" ? "var(--accent-red)" : "var(--accent-cyan)");">
                @if (toastType == "success") { <i data-lucide="check-circle" style="color: #10b981; width: 18px; height: 18px;"></i> }
                else if (toastType == "warning") { <i data-lucide="alert-circle" style="color: #f59e0b; width: 18px; height: 18px;"></i> }
                else if (toastType == "danger") { <i data-lucide="alert-circle" style="color: #ef4444; width: 18px; height: 18px;"></i> }
                else { <i data-lucide="info" style="color: #38bdf8; width: 18px; height: 18px;"></i> }
                <span>@toastMessage</span>
              </div>
            </div>
        }
      </div>
  }
  else
  {
      <!-- Authenticated View (Exact match to App.jsx) -->
      <div class="app-container" id="appMainContainer">
        <!-- LEFT SIDEBAR -->
        <partial name="_Sidebar" />

        <!-- MAIN WRAPPER -->
        <div class="main-wrapper">
          <!-- TOP SYSTEM NAVBAR -->
          <partial name="_TopNavbar" />

          <!-- ACTIVE PAGE VIEW -->
          <main>
            @RenderBody()
          </main>
        </div>

        <!-- MODAL DIALOGS -->
        <partial name="_Modals" />

        <!-- TOAST ALERTS -->
        @if (!string.IsNullOrEmpty(toastMessage))
        {
            <div class="toast-container" id="toastAlert">
              <div class="toast-box" style="border-left-color: @(toastType == "success" ? "var(--accent-green)" : toastType == "warning" ? "var(--accent-yellow)" : toastType == "danger" ? "var(--accent-red)" : "var(--accent-cyan)");">
                @if (toastType == "success") { <i data-lucide="check-circle" style="color: #10b981; width: 18px; height: 18px;"></i> }
                else if (toastType == "warning") { <i data-lucide="alert-circle" style="color: #f59e0b; width: 18px; height: 18px;"></i> }
                else if (toastType == "danger") { <i data-lucide="alert-circle" style="color: #ef4444; width: 18px; height: 18px;"></i> }
                else { <i data-lucide="info" style="color: #38bdf8; width: 18px; height: 18px;"></i> }
                <span>@toastMessage</span>
              </div>
            </div>
        }
      </div>
  }

  <!-- Vendor Scripts -->
  <script src="~/lib/chartjs/chart.umd.js"></script>
  <script src="~/lib/confetti/confetti.browser.js"></script>
  <script src="~/lib/lucide/lucide.min.js"></script>
  <script src="~/js/qworks-ui.js" asp-append-version="true"></script>
  <script src="~/js/slicer.js" asp-append-version="true"></script>

  <script>
    document.addEventListener("DOMContentLoaded", function() {
      if (window.lucide) {
        window.lucide.createIcons();
      }
      var toast = document.getElementById("toastAlert");
      if (toast) {
        setTimeout(function() {
          toast.style.transition = "opacity 0.4s ease";
          toast.style.opacity = "0";
          setTimeout(function() { toast.remove(); }, 400);
        }, 4000);
      }
    });
  </script>
  @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
