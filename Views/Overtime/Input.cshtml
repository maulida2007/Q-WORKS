  function checkHoliday(dateStr) {
    if (!dateStr) return { isHoliday: false, desc: 'Hari Kerja Biasa' };
    var parts = dateStr.split('-');
    if (parts.length !== 3) return { isHoliday: false, desc: 'Hari Kerja Biasa' };
    var y = parseInt(parts[0]);
    var m = parseInt(parts[1]) - 1;
    var d = parseInt(parts[2]);
    var dt = new Date(y, m, d);

    // Hari Minggu
    if (dt.getDay() === 0) {
      return { isHoliday: true, desc: 'Hari Minggu' };
    }

    // Hari Libur Nasional Dinamis
    if (dynamicHolidays[dateStr]) {
      return { isHoliday: true, desc: dynamicHolidays[dateStr] };
    }

    // Hari Libur Nasional Tahunan Tetap
    var mmdd = String(m + 1).padStart(2, '0') + '-' + String(d).padStart(2, '0');
    if (fixedHolidays[mmdd]) {
      return { isHoliday: true, desc: fixedHolidays[mmdd] };
    }

    return { isHoliday: false, desc: 'Hari Kerja Biasa' };
  }

  function onDateChange() {
    var dateVal = document.getElementById('workDateInput').value;
    var hol = checkHoliday(dateVal);
    setDayType(hol.isHoliday);
  }

  // Day type: DOT vs HOT
  function setDayType(isHoliday) {
    document.getElementById('isHolidayHidden').value = isHoliday ? 'true' : 'false';
    var dot = document.getElementById('dotBtn');
    var hot = document.getElementById('hotBtn');

    if (isHoliday) {
      hot.style.border = '1.5px solid #fbbf24';
      hot.style.background = 'linear-gradient(135deg, rgba(245, 158, 11, 0.45) 0%, rgba(217, 119, 6, 0.3) 100%)';
      hot.style.color = '#fbbf24';
      hot.style.boxShadow = '0 0 10px rgba(245, 158, 11, 0.35)';

      dot.style.border = '1.5px solid rgba(67, 139, 196, 0.35)';
      dot.style.background = 'rgba(10, 22, 45, 0.7)';
      dot.style.color = '#8CC1E9';
      dot.style.boxShadow = 'none';
    } else {
      dot.style.border = '1.5px solid #00d2ff';
      dot.style.background = 'linear-gradient(135deg, rgba(0, 136, 255, 0.45) 0%, rgba(2, 132, 199, 0.3) 100%)';
      dot.style.color = '#ffffff';
      dot.style.boxShadow = '0 0 10px rgba(0, 210, 255, 0.35)';

      hot.style.border = '1.5px solid rgba(67, 139, 196, 0.35)';
      hot.style.background = 'rgba(10, 22, 45, 0.7)';
      hot.style.color = '#8CC1E9';
      hot.style.boxShadow = 'none';
    }
    recalculatePreview();
  }

  // Helper to format hours & TUL with exact 2 decimals if needed (e.g. 0.25, 1.75) or 1 decimal (1.0, 1.5)
  function formatDecimal(val) {
    if (typeof val !== 'number') val = parseFloat(val) || 0;
    var rounded = Math.round(val * 100) / 100;
    var s = rounded.toFixed(2);
    if (s.endsWith('00')) return rounded.toFixed(1);
    if (s.endsWith('0')) return rounded.toFixed(1);
    return s;
  }

  // Recalculate duration and TUL client-side
  function recalculatePreview() {
    var inVal = document.getElementById('jamMasukInput').value;
    var outVal = document.getElementById('jamPulangInput').value;
    var isHoliday = document.getElementById('isHolidayHidden').value === 'true';
    var dateVal = document.getElementById('workDateInput').value;
    var holInfo = checkHoliday(dateVal);
    var effectiveHoliday = isHoliday || holInfo.isHoliday;

    if (!inVal || !outVal) return;

    var inParts = inVal.split(':');
    var outParts = outVal.split(':');
    var inMin = parseInt(inParts[0]) * 60 + parseInt(inParts[1]);
    var outMin = parseInt(outParts[0]) * 60 + parseInt(outParts[1]);

    if (outMin < inMin) {
      outMin += 24 * 60; // Next day wrap
    }

    var rawMinutes = outMin - inMin;
    var rawHours = Math.round((rawMinutes / 60.0) * 100) / 100;

    var submitBtn = document.getElementById('submitOvertimeBtn');
    var statusText = document.getElementById('calcStatusText');
    var statusIcon = document.getElementById('calcStatusIcon');
    var durationBadge = document.getElementById('durationStatusBadge');

    // ATURAN 3: Validasi input minimal (harus > 15 menit)
    if (rawMinutes <= 15) {
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.style.opacity = '0.5';
        submitBtn.style.cursor = 'not-allowed';
      }
      if (statusText) {
        statusText.innerText = 'STATUS: DURASI TIDAK VALID (<= 15 MENIT)';
        statusText.style.color = '#f43f5e';
      }
      if (statusIcon) {
        statusIcon.setAttribute('data-lucide', 'alert-circle');
        statusIcon.style.color = '#f43f5e';
      }
      if (durationBadge) {
        durationBadge.innerText = rawMinutes + ' Menit (Input <= 15 Menit Tidak Valid)';
        durationBadge.style.color = '#fb7185';
        durationBadge.style.background = 'rgba(244, 63, 94, 0.15)';
        durationBadge.style.borderColor = 'rgba(244, 63, 94, 0.35)';
      }
      document.getElementById('previewJamVal').innerText = '0.0';
      document.getElementById('previewTulVal').innerText = '0.0';
      document.getElementById('previewFormulaBreakdown').innerText = 'Input ' + formatDecimal(rawHours) + ' jam tidak valid. Wajib > 15 menit karena terdapat pengurangan tetap 15 menit (0.25 jam) istirahat.';
      if (window.lucide) lucide.createIcons();
      return;
    }

    // ATURAN 2: Validasi Hari Libur (Maksimal 7 jam total input)
    if (effectiveHoliday && rawMinutes > 7 * 60) {
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.style.opacity = '0.5';
        submitBtn.style.cursor = 'not-allowed';
      }
      if (statusText) {
        statusText.innerText = 'STATUS: DITOLAK (HARI LIBUR MAKSIMAL 7 JAM)';
        statusText.style.color = '#f43f5e';
      }
      if (statusIcon) {
        statusIcon.setAttribute('data-lucide', 'alert-circle');
        statusIcon.style.color = '#f43f5e';
      }
      if (durationBadge) {
        durationBadge.innerText = rawMinutes + ' Menit (' + formatDecimal(rawHours) + ' Jam - Melebihi Batas Maksimal 7 Jam)';
        durationBadge.style.color = '#fb7185';
        durationBadge.style.background = 'rgba(244, 63, 94, 0.15)';
        durationBadge.style.borderColor = 'rgba(244, 63, 94, 0.35)';
      }
      document.getElementById('previewJamVal').innerText = '0.0';
      document.getElementById('previewTulVal').innerText = '0.0';
      document.getElementById('previewFormulaBreakdown').innerText = 'Untuk hari libur (' + holInfo.desc + '), batas maksimal adalah 7 jam.';
      if (window.lucide) lucide.createIcons();
      return;
    }

    // Input Valid (> 15 menit dan <= 7 jam di hari libur)
    if (submitBtn) {
      submitBtn.disabled = false;
      submitBtn.style.opacity = '1';
      submitBtn.style.cursor = 'pointer';
    }

    var countedMinutes = 0;
    var jamOvertime = 0;
    var tul = 0;
    var breakdown = '';

    if (effectiveHoliday) {
      // ATURAN 2: Hari Libur (Minggu / Libur Nasional)
      // Pengurangan tetap 15 menit untuk istirahat (0.25 jam).
      // Rumus: durasi kerja bersih = durasi input - 15 menit istirahat
      countedMinutes = rawMinutes - 15; // kurangi 15 menit istirahat
      jamOvertime = Math.round((countedMinutes / 60.0) * 100) / 100;

      // Hitung TUL Libur (Jam 1-6: x2.0)
      tul = jamOvertime * 2.0;
      breakdown = formatDecimal(jamOvertime) + ' jam kerja × 2.0 = ' + formatDecimal(tul) + ' TUL (Total ' + formatDecimal(rawHours) + ' jam - 15 menit istirahat = ' + formatDecimal(jamOvertime) + ' jam kerja)';
      tul = Math.round(tul * 100) / 100;

      if (durationBadge) {
        durationBadge.innerText = countedMinutes + ' Menit Bersih (' + formatDecimal(jamOvertime) + ' Jam Kerja Efektif + 15 Menit Istirahat)';
      }

      if (statusText) {
        statusText.innerText = 'STATUS: SAH (HARI LIBUR - ' + holInfo.desc.toUpperCase() + ')';
        statusText.style.color = '#fbbf24';
      }
      if (statusIcon) {
        statusIcon.setAttribute('data-lucide', 'calendar');
        statusIcon.style.color = '#fbbf24';
      }
    } else {
      // ATURAN 1: Hari Kerja Biasa
      // Tidak ada batas maksimal durasi lembur.
      // Pengurangan tetap 15 menit untuk istirahat (0.25 jam).
      // Rumus: durasi lembur bersih = durasi input - 15 menit (0.25 jam).
      countedMinutes = rawMinutes - 15;
      jamOvertime = Math.round((countedMinutes / 60.0) * 100) / 100;

      // Hitung TUL Kerja (Jam 1: x1.5, Jam 2+: x2.0)
      if (jamOvertime <= 1) {
        tul = jamOvertime * 1.5;
        breakdown = formatDecimal(jamOvertime) + ' jam × 1.5 = ' + formatDecimal(tul) + ' TUL';
      } else {
        tul = 1.5 + (jamOvertime - 1.0) * 2.0;
        breakdown = '(1 jam × 1.5) + (' + formatDecimal(jamOvertime - 1.0) + ' jam × 2.0) = ' + formatDecimal(tul) + ' TUL';
      }

      tul = Math.round(tul * 100) / 100;

      if (durationBadge) {
        durationBadge.innerText = countedMinutes + ' Menit Bersih (Input: ' + formatDecimal(rawHours) + ' Jam - 15 Menit Istirahat)';
      }

      if (statusText) {
        statusText.innerText = 'STATUS: SAH (HARI KERJA BIASA)';
        statusText.style.color = '#10b981';
      }
      if (statusIcon) {
        statusIcon.setAttribute('data-lucide', 'check-circle-2');
        statusIcon.style.color = '#10b981';
      }
    }

    if (durationBadge) {
      durationBadge.style.color = '#34d399';
      durationBadge.style.background = 'rgba(52, 211, 153, 0.12)';
      durationBadge.style.borderColor = 'rgba(52, 211, 153, 0.3)';
    }

    document.getElementById('previewJamVal').innerText = formatDecimal(jamOvertime);
    document.getElementById('previewTulVal').innerText = formatDecimal(tul);
    document.getElementById('previewFormulaBreakdown').innerText = breakdown;

    if (window.lucide) lucide.createIcons();
  }

  // Form submission interceptor to strictly enforce validation rules
  var otForm = document.getElementById('overtimeForm');
  if (otForm) {
    otForm.addEventListener('submit', function(e) {
      var npk = document.getElementById('selectedNpkHidden').value;
      if (!npk) {
        e.preventDefault();
        alert('Silakan pilih nama karyawan terlebih dahulu.');
        return false;
      }

      var inVal = document.getElementById('jamMasukInput').value;
      var outVal = document.getElementById('jamPulangInput').value;
      var isHoliday = document.getElementById('isHolidayHidden').value === 'true';
      var dateVal = document.getElementById('workDateInput').value;
      var holInfo = checkHoliday(dateVal);
      var effectiveHoliday = isHoliday || holInfo.isHoliday;

      if (!inVal || !outVal) {
        e.preventDefault();
        alert('Jam mulai dan jam selesai lembur wajib diisi.');
        return false;
      }

      var inParts = inVal.split(':');
      var outParts = outVal.split(':');
      var inMin = parseInt(inParts[0]) * 60 + parseInt(inParts[1]);
      var outMin = parseInt(outParts[0]) * 60 + parseInt(outParts[1]);
      if (outMin < inMin) outMin += 24 * 60;
      var rawMinutes = outMin - inMin;

      if (rawMinutes <= 15) {
        e.preventDefault();
        alert('Durasi input harus lebih dari 15 menit (0.25 jam) karena terdapat pengurangan tetap 15 menit istirahat.');
        return false;
      }

      if (effectiveHoliday && rawMinutes > 7 * 60) {
        e.preventDefault();
        alert('Untuk hari libur (' + holInfo.desc + '), batas maksimal input adalah 7 jam.');
        return false;
      }
    });
  }

  function resetInputForm() {
    document.getElementById('overtimeForm').reset();
    @if (isKaryawan)
    {
      <text>
      if (document.getElementById('selectedNpkHidden')) document.getElementById('selectedNpkHidden').value = '@currentUser?.Npk';
      if (document.getElementById('selectedNameHidden')) document.getElementById('selectedNameHidden').value = '@currentUser?.Name';
      if (document.getElementById('npkDisplayInput')) document.getElementById('npkDisplayInput').value = '@currentUser?.Npk';
      </text>
    }
    setShift('Shift 1');
    onDateChange();
  }

  // Close dropdown on clicking outside
  document.addEventListener('click', function(e) {
    var trigger = document.getElementById('empSelectorTrigger');
    var popup = document.getElementById('empDropdownPopup');
    if (trigger && popup && !trigger.contains(e.target) && !popup.contains(e.target)) {
      if (isDropdownOpen) toggleEmpDropdown();
    }
  });

  // Toggle Tabel Perhitungan TUL Lembur
  var isTulTableOpen = false;
  function toggleTulTable() {
    isTulTableOpen = !isTulTableOpen;
    var container = document.getElementById('tulTableContainer');
    var chevron = document.getElementById('tulTableChevron');
    if (container) {
      container.style.display = isTulTableOpen ? 'block' : 'none';
    }
    if (chevron) {
      chevron.style.transform = isTulTableOpen ? 'rotate(180deg)' : 'rotate(0deg)';
    }
    if (window.lucide) lucide.createIcons();
  }

  // Initial calculation and holiday detection
  onDateChange();
</script>
}
