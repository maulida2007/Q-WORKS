          </div>
        </div>
      </div>

      <!-- 7. REALTIME OVERTIME VALIDATION & CALCULATION SUMMARY CARD -->
      <div
        id="calcCard"
        style="
          background-color: rgba(9, 26, 56, 0.95);
          border: 1.5px solid rgba(0, 210, 255, 0.45);
          border-radius: 14px;
          padding: 18px 24px;
          display: flex;
          flex-direction: column;
          gap: 12px;
          box-shadow: 0 6px 20px rgba(0, 0, 0, 0.35);
        "
      >
        <!-- Header Validation Result -->
        <div style="display: flex; align-items: center; justify-content: space-between;">
          <div style="display: flex; align-items: center; gap: 8px;">
            <i data-lucide="check-circle-2" id="calcStatusIcon" style="width: 20px; height: 20px; color: #10b981;"></i>
            <span id="calcStatusText" style="font-size: 0.94rem; font-weight: 800; color: #FFF8E7;">
              STATUS: SAH (LEMBUR SETELAH SHIFT)
            </span>
          </div>

          <button
            type="button"
            id="toggleTulTableBtn"
            onclick="toggleTulTable();"
            style="
              background: rgba(14, 165, 233, 0.12);
              border: 1px solid rgba(56, 189, 248, 0.35);
              border-radius: 6px;
              padding: 5px 12px;
              color: #38bdf8;
              font-size: 0.78rem;
              font-weight: 700;
              cursor: pointer;
              display: inline-flex;
              align-items: center;
              gap: 6px;
              transition: all 0.2s ease;
            "
            onmouseenter="this.style.background='rgba(14, 165, 233, 0.22)'; this.style.borderColor='#38bdf8';"
            onmouseleave="this.style.background='rgba(14, 165, 233, 0.12)'; this.style.borderColor='rgba(56, 189, 248, 0.35)';"
            title="Klik untuk membuka / menutup Tabel Perhitungan TUL Lembur"
          >
