@model InputOvertimeViewModel
@inject IAuthService AuthService
@{
    ViewData["Title"] = "Input Data Lembur";
    Layout = "_Layout";
    var currentUser = AuthService.GetCurrentUser();
    bool isKaryawan = currentUser?.IsKaryawan == true;
    bool isAdmin = currentUser?.IsAdmin == true;
}
@functions {
    public static readonly (string Jam, string Tul)[] TabelTulKerja = new[]
    {
        ("0", "0"), ("1", "1,5"), ("1,25", "2"), ("1,5", "2,5"), ("1,75", "3"),
        ("2", "3,5"), ("2,25", "4"), ("2,5", "4,5"), ("2,75", "5"), ("3", "5,5"),
        ("3,25", "6"), ("3,5", "6,5"), ("3,75", "7"), ("4", "7,5"), ("4,5", "8,5"),
        ("4,75", "9"), ("5", "9,5"), ("5,5", "10,5"), ("6", "11,5"), ("6,5", "12,5"),
        ("7", "13,5"), ("7,5", "14,5"), ("8", "15,5"), ("8,5", "16,5"), ("9", "17,5"),
        ("9,5", "18,5"), ("10", "19,5"), ("10,5", "20,5"), ("11", "21,5"), ("11,5", "22,5"),
        ("12", "23,5"), ("12,5", "24,5"), ("13", "25,5"), ("13,5", "26,5"), ("14", "27,5"),
        ("14,5", "28,5"), ("15", "29,5"), ("15,5", "30,5"), ("16", "31,5"), ("16,5", "32,5"),
        ("17", "33,5"), ("17,5", "34,5"), ("18", "35,5"), ("18,5", "36,5"), ("19", "37,5"),
        ("19,5", "38,5"), ("20", "39,5"), ("20,5", "40,5"), ("21", "41,5"), ("21,5", "42,5"),
        ("22", "43,5"), ("22,5", "44,5"), ("23", "45,5"), ("23,5", "46,5"), ("24", "47,5")
    };

    public static readonly (string Jam, string Tul)[] TabelTulLibur = new[]
    {
        ("0", "0"), ("1", "2"), ("1,5", "3"), ("2", "4"), ("2,5", "5"),
        ("3", "6"), ("3,5", "7"), ("4", "8"), ("4,5", "9"), ("5", "10"),
        ("5,5", "11"), ("6", "12 (Maks)")
    };
}


<div class="page-content" style="max-width: 1400px; margin: 0 auto; display: flex; flex-direction: column; gap: 20px;">

  <!-- 1. TOP EXECUTIVE HERO BANNER -->
  <div class="dashboard-hero-mockup-card" style="margin-bottom: 0;">
    <div class="hero-mockup-left">
      <div class="hero-glowing-icon">
        <i data-lucide="clipboard-pen-line" style="width: 22px; height: 22px; color: #ffffff;"></i>
      </div>
      <div class="hero-text-block">
        <span class="hero-dept-tag">QUALITY CONTROL</span>
        <h1 class="hero-main-title">Input Data Lembur</h1>
        <span class="hero-desc">
          Pencatatan data lembur harian QC dengan kalkulasi durasi dan TUL otomatis.
        </span>
      </div>
    </div>

    <!-- Live Status Right -->
    <div class="hero-live-status-card">
      <div class="hero-live-clock-icon">
        <i data-lucide="clock" style="width: 15px; height: 15px; color: #38bdf8;"></i>
      </div>
      <div class="hero-status-texts">
        <span class="hero-status-label">Waktu Sistem</span>
        <span class="hero-status-time" id="inputLiveClock">--</span>
      </div>
    </div>
  </div>

  <!-- 2. MAIN FORM CONTAINER -->
  <form id="overtimeForm" method="post" action="/Overtime/Submit" style="width: 100%; max-width: 900px; margin: 0 auto;">
    @Html.AntiForgeryToken()

    <div
      class="filter-parameter-mockup-card"
      style="
        padding: 24px 28px;
        border-radius: 14px;
        display: flex;
        flex-direction: column;
        gap: 16px;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
        border: 1px solid rgba(255, 255, 255, 0.08);
        background: rgba(9, 24, 52, 0.75);
      "
    >
      <!-- Header Row -->
      <div style="display: flex; align-items: center; justify-content: space-between; padding-bottom: 14px; border-bottom: 1px solid rgba(67, 139, 196, 0.25);">
        <div style="display: flex; align-items: center; gap: 10px;">
          <i data-lucide="clipboard-pen-line" style="width: 20px; height: 20px; color: #00d2ff;"></i>
          <span style="font-size: 1.05rem; font-weight: 800; color: #FFF8E7; font-family: 'Outfit', sans-serif; letter-spacing: 0.04em;">
            FORMULIR INPUT DATA LEMBUR
          </span>
        </div>

        <a href="/MasterPekerja" class="btn-master-primary" style="padding: 7px 16px; font-size: 0.82rem; gap: 6; text-decoration: none;" title="Kelola data pekerja di master">
          <i data-lucide="user-plus" style="width: 14px; height: 14px;"></i>
          <span>Master Pekerja</span>
        </a>
      </div>

      <!-- 1. PLANT -->
      <div class="form-group" style="margin-bottom: 0;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
          <label class="form-label" style="font-size: 0.86rem; font-weight: 800; color: #FFF8E7; letter-spacing: 0.04em; margin-bottom: 0;">
            <i data-lucide="building-2" style="width: 15px; height: 15px; display: inline; margin-right: 6px; color: #00d2ff;"></i>
            PLANT
          </label>
          @if (isKaryawan)
          {
            <span style="font-size: 0.72rem; color: #34d399; font-weight: 700; background: rgba(52, 211, 153, 0.12); padding: 2px 8px; border-radius: 4px; border: 1px solid rgba(52, 211, 153, 0.25);">
              ✓ Terisi Otomatis
            </span>
          }
        </div>

        @if (isKaryawan)
        {
          <input type="hidden" name="plant" id="plantSelect" value="@currentUser?.Plant" />
          <div
            style="
              display: flex;
              align-items: center;
              padding: 0 16px;
              font-size: 0.92rem;
              font-weight: 700;
              background: rgba(10, 22, 45, 0.65);
              border-radius: 8px;
              height: 44px;
              width: 100%;
              border: 1px solid rgba(67, 139, 196, 0.3);
              color: #FFF8E7;
              box-sizing: border-box;
              gap: 8px;
            "
          >
            <i data-lucide="building-2" style="width: 16px; height: 16px; color: #38bdf8;"></i>
            <span>@(currentUser?.Plant ?? Model.DefaultPlant)</span>
          </div>
        }
        else
        {
          <select
            name="plant"
            id="plantSelect"
            class="form-select"
            required
            style="padding: 11px 16px; font-size: 0.92rem; background: rgba(10, 22, 45, 0.85); border-radius: 8px; height: 44px; width: 100%; border: 1px solid rgba(67, 139, 196, 0.35); color: #FFF8E7;"
            onchange="onPlantChange();"
          >
            <option value="">- Pilih plant -</option>
            @foreach (var p in Model.AllowedPlants)
            {
              <option value="@p" selected="@(p == Model.DefaultPlant)">@p</option>
            }
          </select>
        }
      </div>

      <!-- 2. NAMA KARYAWAN -->
      @if (isKaryawan)
      {
        <!-- Karyawan: Nama & NPK Otomatis Terkunci Sesuai Akun Login -->
        <input type="hidden" name="npks" id="selectedNpkHidden" value="@currentUser?.Npk" required />
        <input type="hidden" name="employeeName" id="selectedNameHidden" value="@currentUser?.Name" />

        <div class="form-group" style="margin-bottom: 0;">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
            <label class="form-label" style="font-size: 0.86rem; font-weight: 800; color: #FFF8E7; letter-spacing: 0.04em; margin-bottom: 0;">
              <i data-lucide="user" style="width: 15px; height: 15px; display: inline; margin-right: 6px; color: #00d2ff;"></i>
              NAMA KARYAWAN
            </label>
            <span style="font-size: 0.72rem; color: #34d399; font-weight: 700; background: rgba(52, 211, 153, 0.12); padding: 2px 8px; border-radius: 4px; border: 1px solid rgba(52, 211, 153, 0.25);">
              ✓ Terisi Otomatis
            </span>
          </div>

          <div
            style="
              display: flex;
              align-items: center;
              justify-content: space-between;
              padding: 0 16px;
              height: 44px;
              background: rgba(10, 22, 45, 0.65);
              border: 1px solid rgba(67, 139, 196, 0.3);
              border-radius: 8px;
              box-sizing: border-box;
            "
          >
            <div style="display: flex; align-items: center; gap: 10px;">
              <div
                style="
                  width: 28px;
                  height: 28px;
                  border-radius: 50%;
                  background: linear-gradient(135deg, rgba(0, 136, 255, 0.3) 0%, rgba(2, 132, 199, 0.2) 100%);
                  border: 1px solid rgba(0, 210, 255, 0.4);
                  color: #FFF8E7;
                  display: flex;
                  align-items: center;
                  justify-content: center;
                  font-size: 0.78rem;
                  font-weight: 800;
                  flex-shrink: 0;
                "
              >
                @(string.IsNullOrEmpty(currentUser?.Name) ? "K" : currentUser.Name.Substring(0, 1).ToUpper())
              </div>
              <span id="selectedEmpDisplay" style="font-size: 0.92rem; font-weight: 700; color: #FFF8E7;">
                @currentUser?.Name
              </span>
            </div>
            <span style="font-size: 0.82rem; color: #38bdf8; font-family: 'JetBrains Mono', monospace; font-weight: 700; background: rgba(14, 165, 233, 0.12); padding: 2px 10px; border-radius: 6px; border: 1px solid rgba(56, 189, 248, 0.25);">
              NPK: @currentUser?.Npk
            </span>
          </div>
        </div>
      }
      else
      {
        <!-- Admin: Searchable Selector untuk Memilih Karyawan Mana Saja -->
        <div class="form-group" style="margin-bottom: 0; position: relative;">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
            <label class="form-label" style="font-size: 0.86rem; font-weight: 800; color: #FFF8E7; letter-spacing: 0.04em; margin-bottom: 0;">
              <i data-lucide="user" style="width: 15px; height: 15px; display: inline; margin-right: 6px; color: #00d2ff;"></i>
              NAMA KARYAWAN
            </label>
            <span style="font-size: 0.76rem; color: #8CC1E9;" id="employeeCountBadge">
              @Model.AvailableEmployees.Count Karyawan Terdaftar
            </span>
          </div>

          <!-- Trigger Box -->
          <div
            id="empSelectorTrigger"
            onclick="toggleEmpDropdown();"
            style="
              display: flex;
              align-items: center;
              justify-content: space-between;
              padding: 0 16px;
              height: 44px;
              background: rgba(10, 22, 45, 0.95);
              border: 1.5px solid rgba(67, 139, 196, 0.45);
              border-radius: 8px;
              cursor: pointer;
              transition: all 0.15s ease;
              box-sizing: border-box;
            "
          >
            <span id="selectedEmpDisplay" style="font-size: 0.92rem; font-weight: 600; color: #FFF8E7;">
              - Pilih / Cari Nama Karyawan -
            </span>
            <div style="display: flex; align-items: center; gap: 6px;">
              <i data-lucide="search" style="width: 14px; height: 14px; color: #8CC1E9;"></i>
              <i data-lucide="chevron-down" id="empDropdownChevron" style="width: 16px; height: 16px; color: #8CC1E9; transition: transform 0.2s ease;"></i>
            </div>
          </div>

          <!-- Dropdown Popup with Integrated Search Bar -->
          <div
            id="empDropdownPopup"
            style="
              display: none;
              position: absolute;
              top: calc(100% + 4px);
              left: 0;
              right: 0;
              z-index: 200;
              background: linear-gradient(180deg, #091a38 0%, #061124 100%);
              border: 1.5px solid rgba(56, 189, 248, 0.45);
              border-radius: 10px;
              box-shadow: 0 12px 36px rgba(0, 0, 0, 0.75), 0 0 16px rgba(0, 136, 255, 0.25);
              overflow: hidden;
            "
          >
            <!-- Search Input -->
            <div style="padding: 10px 12px; border-bottom: 1px solid rgba(255, 255, 255, 0.08); background: rgba(0, 40, 85, 0.4);">
              <div style="position: relative; display: flex; align-items: center;">
                <i data-lucide="search" style="width: 14px; height: 14px; color: #38bdf8; position: absolute; left: 10px;"></i>
                <input
                  type="text"
                  id="empSearchInput"
                  onkeyup="filterEmpList();"
                  placeholder="Cari nama karyawan..."
                  style="
                    width: 100%;
                    height: 34px;
                    padding: 0 10px 0 32px;
                    background: rgba(10, 22, 45, 0.95);
                    border: 1px solid rgba(56, 189, 248, 0.35);
                    border-radius: 6px;
                    color: #FFF8E7;
                    font-size: 0.84rem;
                    outline: none;
                    box-sizing: border-box;
                  "
                />
              </div>
            </div>

            <!-- Employee List -->
            <div id="empListContainer" style="max-height: 220px; overflow-y: auto; padding: 4px 0;">
              @foreach (var emp in Model.AvailableEmployees)
              {
                <div
                  class="emp-option-item"
                  data-npk="@emp.Npk"
                  data-name="@emp.Name"
                  data-plant="@emp.Plant"
                  data-shift="@(emp.Shift ?? "Shift 1")"
                  onclick="selectEmployee('@emp.Name', '@emp.Npk', '@emp.Plant', '@(emp.Shift ?? "Shift 1")');"
                  style="
                    display: flex;
                    align-items: center;
                    justify-content: space-between;
                    padding: 8px 14px;
                    cursor: pointer;
                    transition: background 0.12s ease;
                  "
                >
                  <div style="display: flex; align-items: center; gap: 10px;">
                    <div
                      style="
                        width: 28px;
                        height: 28px;
                        border-radius: 50%;
                        background: rgba(255, 255, 255, 0.08);
                        border: 1px solid rgba(255, 255, 255, 0.15);
                        color: #ffffff;
                        display: flex;
                        align-items: center;
                        justify-content: center;
                        font-size: 0.76rem;
                        font-weight: 800;
                        flex-shrink: 0;
                      "
                    >
                      @(string.IsNullOrEmpty(emp.Name) ? "U" : emp.Name.Substring(0, 1).ToUpper())
                    </div>
                    <span style="font-size: 0.88rem; font-weight: 600; color: #e2e8f0;">
                      @emp.Name
                    </span>
                  </div>
                  <span style="font-size: 0.76rem; color: #38bdf8; font-family: 'JetBrains Mono', monospace;">
                    @emp.Npk
                  </span>
                </div>
              }
            </div>
          </div>

          <!-- Hidden input for selected employee npks -->
          <input type="hidden" name="npks" id="selectedNpkHidden" required />
          <input type="hidden" name="employeeName" id="selectedNameHidden" />

          <!-- Quick chips -->
          <div id="quickChipsContainer" style="display: flex; gap: 6px; flex-wrap: wrap; margin-top: 8px;">
            @foreach (var emp in Model.AvailableEmployees.Take(8))
            {
              <button
                type="button"
                onclick="selectEmployee('@emp.Name', '@emp.Npk', '@emp.Plant', '@(emp.Shift ?? "Shift 1")');"
                style="
                  background-color: rgba(255, 255, 255, 0.04);
                  border: 1px solid rgba(140, 193, 233, 0.18);
                  color: #8CC1E9;
                  font-size: 0.78rem;
                  font-weight: 500;
                  padding: 4px 10px;
                  border-radius: 6px;
                  cursor: pointer;
                "
              >
                @emp.Name
              </button>
            }
          </div>
        </div>
      }

      <!-- ROW: NPK & SHIFT -->
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
        <!-- 3. NPK -->
        <div class="form-group" style="margin-bottom: 0;">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; min-height: 22px;">
            <label class="form-label" style="font-size: 0.86rem; font-weight: 800; color: #FFF8E7; letter-spacing: 0.04em; margin-bottom: 0;">
              <i data-lucide="file-text" style="width: 15px; height: 15px; display: inline; margin-right: 6px; color: #00d2ff;"></i>
              NPK
            </label>
            <span style="font-size: 0.72rem; color: #34d399; font-weight: 700; background: rgba(52, 211, 153, 0.12); padding: 2px 8px; border-radius: 4px; border: 1px solid rgba(52, 211, 153, 0.25);">
              ✓ Terisi Otomatis
            </span>
          </div>
          <input
            type="text"
            id="npkDisplayInput"
            value="@(isKaryawan ? currentUser?.Npk : "")"
            placeholder="NPK Karyawan"
            readonly
            style="
              width: 100%;
              padding: 0 16px;
              font-size: 0.92rem;
              background: rgba(10, 22, 45, 0.85);
              border-radius: 8px;
              font-family: 'JetBrains Mono', monospace;
              font-weight: 700;
              height: 44px;
              border: 1px solid rgba(67, 139, 196, 0.35);
              color: #FFF8E7;
              box-sizing: border-box;
            "
          />
        </div>

        <!-- 4. SHIFT SELECTION -->
        <div class="form-group" style="margin-bottom: 0;">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; min-height: 22px;">
            <label class="form-label" style="font-size: 0.85rem; font-weight: 800; color: #FFF8E7; letter-spacing: 0.04em; margin-bottom: 0; white-space: nowrap;">
              <i data-lucide="layers" style="width: 15px; height: 15px; display: inline; margin-right: 6px; color: #00d2ff;"></i>
              PILIH SHIFT
            </label>
            <span id="shiftTimeBadge" style="font-size: 0.72rem; color: #818cf8; font-weight: 700; background: rgba(129, 140, 248, 0.15); padding: 2px 8px; border-radius: 4px; border: 1px solid rgba(129, 140, 248, 0.35); white-space: nowrap;">
              22:30 - 07:30 (Malam)
            </span>
          </div>
          <input type="hidden" name="shiftName" id="shiftNameHidden" value="Shift 1" />
          <div
            style="
              display: grid;
              grid-template-columns: 1fr 1fr;
              gap: 6px;
              height: 44px;
              background: rgba(10, 22, 45, 0.85);
              padding: 4px;
              border-radius: 8px;
              border: 1px solid rgba(67, 139, 196, 0.35);
              box-sizing: border-box;
            "
          >
            <button
              type="button"
              id="shiftBtn1"
              onclick="setShift('Shift 1');"
              style="
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 6px;
                height: 100%;
                border-radius: 6px;
                border: 1px solid #818cf8;
                background: linear-gradient(135deg, rgba(79, 70, 229, 0.45) 0%, rgba(129, 140, 248, 0.3) 100%);
                color: #c7d2fe;
                font-weight: 800;
                font-size: 0.88rem;
                cursor: pointer;
                transition: all 0.2s;
              "
            >
              <i data-lucide="moon" style="width: 14px; height: 14px;"></i>
              <span>Shift 1 (Malam)</span>
            </button>
            <button
              type="button"
              id="shiftBtn2"
              onclick="setShift('Shift 2');"
              style="
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 6px;
                height: 100%;
                border-radius: 6px;
                border: 1px solid transparent;
                background: transparent;
                color: #8CC1E9;
                font-weight: 600;
                font-size: 0.88rem;
                cursor: pointer;
                transition: all 0.2s;
              "
            >
              <i data-lucide="sun" style="width: 14px; height: 14px;"></i>
              <span>Shift 2 (Pagi)</span>
            </button>
          </div>
        </div>
      </div>

      <!-- ROW: TGL OVERTIME & JAM / WAKTU OVERTIME -->
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
        <!-- 5. TGL OVERTIME & TIPE HARI -->
        <div class="form-group" style="margin-bottom: 0;">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; min-height: 32px;">
            <label class="form-label" style="font-size: 0.85rem; font-weight: 800; color: #FFF8E7; letter-spacing: 0.04em; margin-bottom: 0; white-space: nowrap;">
              <i data-lucide="calendar" style="width: 15px; height: 15px; display: inline; margin-right: 6px; color: #00d2ff;"></i>
              TGL SHIFT / LEMBUR
            </label>
            <div style="display: flex; gap: 8px;">
              <button
                type="button"
                id="dotBtn"
                onclick="setDayType(false);"
                style="padding: 6px 16px; border-radius: 6px; font-size: 0.88rem; font-weight: 800; letter-spacing: 0.04em; cursor: pointer; border: 1.5px solid #00d2ff; background: linear-gradient(135deg, rgba(0, 136, 255, 0.45) 0%, rgba(2, 132, 199, 0.3) 100%); color: #ffffff; box-shadow: 0 0 10px rgba(0, 210, 255, 0.35); transition: all 0.2s ease;"
                title="D.O.T (Hari Kerja: Jam 1: 1.5x, Jam 2+: 2.0x)"
              >
                D.O.T
              </button>
              <button
                type="button"
                id="hotBtn"
                onclick="setDayType(true);"
                style="padding: 6px 16px; border-radius: 6px; font-size: 0.88rem; font-weight: 800; letter-spacing: 0.04em; cursor: pointer; border: 1.5px solid rgba(67, 139, 196, 0.35); background: rgba(10, 22, 45, 0.7); color: #8CC1E9; transition: all 0.2s ease;"
                title="H.O.T (Hari Libur: Maksimal 7 jam kerja, Jam 1-6 Bersih: 2.0x TUL)"
              >
                H.O.T
              </button>
            </div>
          </div>
          <input type="hidden" name="isHoliday" id="isHolidayHidden" value="false" />
          <input
            type="date"
            name="workDate"
            id="workDateInput"
            value="@Model.DefaultDate"
            required
            style="
              width: 100%;
              padding: 0 14px;
              font-size: 0.92rem;
              background: rgba(10, 22, 45, 0.85);
              border-radius: 8px;
              height: 44px;
              border: 1px solid rgba(67, 139, 196, 0.35);
              color: #FFF8E7;
              color-scheme: dark;
              box-sizing: border-box;
            "
            onchange="onDateChange();"
          />
        </div>

        <!-- 6. JAM / WAKTU (ACTUAL) -->
        <div class="form-group" style="margin-bottom: 0;">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; min-height: 22px;">
            <label class="form-label" style="font-size: 0.85rem; font-weight: 800; color: #FFF8E7; letter-spacing: 0.04em; margin-bottom: 0; white-space: nowrap;">
              <i data-lucide="clock" style="width: 15px; height: 15px; display: inline; margin-right: 6px; color: #00d2ff;"></i>
              RENTANG JAM LEMBUR
            </label>
            <span id="durationStatusBadge" style="font-size: 0.72rem; color: #34d399; font-weight: 700; background: rgba(52, 211, 153, 0.12); padding: 2px 8px; border-radius: 4px; border: 1px solid rgba(52, 211, 153, 0.3); white-space: nowrap;">
              120 Menit Total
            </span>
          </div>

          <div style="display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 10px; height: 44px;">
            <div style="display: flex; align-items: center; justify-content: space-between; background: rgba(10, 22, 45, 0.95); border: 1.5px solid rgba(67, 139, 196, 0.45); border-radius: 8px; height: 44px; padding: 0 10px; box-sizing: border-box;">
              <span style="font-size: 0.78rem; color: #8CC1E9; font-weight: 800; white-space: nowrap;">Mulai:</span>
              <input type="time" name="jamMasuk" id="jamMasukInput" value="07:30" onchange="recalculatePreview();" style="background: transparent; border: none; color: #FFF8E7; font-size: 0.95rem; font-weight: 800; font-family: 'JetBrains Mono', monospace; outline: none;" />
            </div>

            <span style="color: #00d2ff; font-weight: 800; font-size: 0.95rem;">→</span>

            <div style="display: flex; align-items: center; justify-content: space-between; background: rgba(10, 22, 45, 0.95); border: 1.5px solid rgba(67, 139, 196, 0.45); border-radius: 8px; height: 44px; padding: 0 10px; box-sizing: border-box;">
              <span style="font-size: 0.78rem; color: #8CC1E9; font-weight: 800; white-space: nowrap;">Selesai:</span>
              <input type="time" name="jamPulang" id="jamPulangInput" value="09:30" onchange="recalculatePreview();" style="background: transparent; border: none; color: #FFF8E7; font-size: 0.95rem; font-weight: 800; font-family: 'JetBrains Mono', monospace; outline: none;" />
