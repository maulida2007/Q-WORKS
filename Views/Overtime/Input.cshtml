@model InputOvertimeViewModel
@{
    ViewData["Title"] = "Input Data Lembur";
    Layout = "_Layout";
}

<div class="page-content" style="max-width: 1400px; margin: 0 auto; display: flex; flex-direction: column; gap: 20px;">

  <!-- 1. TOP EXECUTIVE HERO BANNER -->
  <div class="dashboard-hero-mockup-card" style="margin-bottom: 0;">
    <div class="hero-mockup-left">
      <div class="hero-glowing-icon">
        <i data-lucide="clipboard-pen-line" style="width: 22px; height: 22px; color: #ffffff;"></i>
      </div>
      <div class="hero-text-block">
        <span class="hero-dept-tag">QUALITY CONTROL</span>
        <h1 class="hero-main-title">Input Data Lembur</h1>
        <span class="hero-desc">
          Pencatatan data lembur harian QC dengan kalkulasi durasi dan TUL otomatis.
        </span>
      </div>
    </div>

    <!-- Live Status Right -->
    <div class="hero-live-status-card">
      <div class="hero-live-clock-icon">
        <i data-lucide="clock" style="width: 15px; height: 15px; color: #38bdf8;"></i>
      </div>
      <div class="hero-status-texts">
        <span class="hero-status-label">Waktu Sistem</span>
        <span class="hero-status-time" id="inputLiveClock">--</span>
      </div>
    </div>
  </div>

  <!-- 2. MAIN FORM CONTAINER -->
  <form id="overtimeForm" method="post" action="/Overtime/Submit" style="width: 100%; max-width: 900px; margin: 0 auto;">
    @Html.AntiForgeryToken()

    <div
      class="filter-parameter-mockup-card"
      style="
        padding: 24px 28px;
        border-radius: 14px;
        display: flex;
        flex-direction: column;
        gap: 16px;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
        border: 1px solid rgba(255, 255, 255, 0.08);
        background: rgba(9, 24, 52, 0.75);
      "
    >
      <!-- Header Row -->
      <div style="display: flex; align-items: center; justify-content: space-between; padding-bottom: 14px; border-bottom: 1px solid rgba(67, 139, 196, 0.25);">
        <div style="display: flex; align-items: center; gap: 10px;">
          <i data-lucide="clipboard-pen-line" style="width: 20px; height: 20px; color: #00d2ff;"></i>
          <span style="font-size: 1.05rem; font-weight: 800; color: #FFF8E7; font-family: 'Outfit', sans-serif; letter-spacing: 0.04em;">
            FORMULIR INPUT DATA LEMBUR
          </span>
        </div>

        <a href="/MasterPekerja" class="btn-master-primary" style="padding: 7px 16px; font-size: 0.82rem; gap: 6; text-decoration: none;" title="Kelola data pekerja di master">
          <i data-lucide="user-plus" style="width: 14px; height: 14px;"></i>
          <span>Master Pekerja</span>
        </a>
      </div>

      <!-- 1. PLANT -->
      <div class="form-group" style="margin-bottom: 0;">
        <label class="form-label" style="font-size: 0.86rem; font-weight: 800; color: #FFF8E7; letter-spacing: 0.04em; margin-bottom: 6px;">
          <i data-lucide="building-2" style="width: 15px; height: 15px; display: inline; margin-right: 6px; color: #00d2ff;"></i>
          PLANT
        </label>
        <select
          name="plant"
          id="plantSelect"
          class="form-select"
          required
          style="padding: 11px 16px; font-size: 0.92rem; background: rgba(10, 22, 45, 0.85); border-radius: 8px; height: 44px; width: 100%; border: 1px solid rgba(67, 139, 196, 0.35); color: #FFF8E7;"
          onchange="onPlantChange();"
        >
          <option value="">- Pilih plant -</option>
          @foreach (var p in Model.AllowedPlants)
          {
            <option value="@p" selected="@(p == Model.DefaultPlant)">@p</option>
          }
        </select>
      </div>

      <!-- 2. NAMA KARYAWAN (SEARCHABLE SELECTOR) -->
      <div class="form-group" style="margin-bottom: 0; position: relative;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
          <label class="form-label" style="font-size: 0.86rem; font-weight: 800; color: #FFF8E7; letter-spacing: 0.04em; margin-bottom: 0;">
            <i data-lucide="user" style="width: 15px; height: 15px; display: inline; margin-right: 6px; color: #00d2ff;"></i>
            NAMA KARYAWAN
          </label>
          <span style="font-size: 0.76rem; color: #8CC1E9;" id="employeeCountBadge">
            @Model.AvailableEmployees.Count Karyawan Terdaftar
          </span>
        </div>

        <!-- Trigger Box -->
        <div
          id="empSelectorTrigger"
          onclick="toggleEmpDropdown();"
          style="
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 16px;
            height: 44px;
            background: rgba(10, 22, 45, 0.95);
            border: 1.5px solid rgba(67, 139, 196, 0.45);
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.15s ease;
            box-sizing: border-box;
          "
        >
          <span id="selectedEmpDisplay" style="font-size: 0.92rem; font-weight: 600; color: #FFF8E7;">
            - Pilih / Cari Nama Karyawan -
          </span>
          <div style="display: flex; align-items: center; gap: 6px;">
            <i data-lucide="search" style="width: 14px; height: 14px; color: #8CC1E9;"></i>
            <i data-lucide="chevron-down" id="empDropdownChevron" style="width: 16px; height: 16px; color: #8CC1E9; transition: transform 0.2s ease;"></i>
          </div>
        </div>

        <!-- Dropdown Popup with Integrated Search Bar -->
        <div
          id="empDropdownPopup"
          style="
            display: none;
            position: absolute;
            top: calc(100% + 4px);
            left: 0;
            right: 0;
            z-index: 200;
            background: linear-gradient(180deg, #091a38 0%, #061124 100%);
            border: 1.5px solid rgba(56, 189, 248, 0.45);
            border-radius: 10px;
            box-shadow: 0 12px 36px rgba(0, 0, 0, 0.75), 0 0 16px rgba(0, 136, 255, 0.25);
            overflow: hidden;
          "
        >
          <!-- Search Input -->
          <div style="padding: 10px 12px; border-bottom: 1px solid rgba(255, 255, 255, 0.08); background: rgba(0, 40, 85, 0.4);">
            <div style="position: relative; display: flex; align-items: center;">
              <i data-lucide="search" style="width: 14px; height: 14px; color: #38bdf8; position: absolute; left: 10px;"></i>
              <input
                type="text"
                id="empSearchInput"
                onkeyup="filterEmpList();"
                placeholder="Cari nama karyawan..."
                style="
                  width: 100%;
                  height: 34px;
                  padding: 0 10px 0 32px;
                  background: rgba(10, 22, 45, 0.95);
                  border: 1px solid rgba(56, 189, 248, 0.35);
                  border-radius: 6px;
                  color: #FFF8E7;
                  font-size: 0.84rem;
                  outline: none;
                  box-sizing: border-box;
                "
              />
            </div>
          </div>

          <!-- Employee List -->
          <div id="empListContainer" style="max-height: 220px; overflow-y: auto; padding: 4px 0;">
            @foreach (var emp in Model.AvailableEmployees)
            {
              <div
                class="emp-option-item"
                data-npk="@emp.Npk"
                data-name="@emp.Name"
                data-plant="@emp.Plant"
                data-shift="@(emp.Shift ?? "Shift 1")"
                onclick="selectEmployee('@emp.Name', '@emp.Npk', '@emp.Plant', '@(emp.Shift ?? "Shift 1")');"
                style="
                  display: flex;
                  align-items: center;
                  justify-content: space-between;
                  padding: 8px 14px;
                  cursor: pointer;
                  transition: background 0.12s ease;
                "
              >
                <div style="display: flex; align-items: center; gap: 10px;">
                  <div
                    style="
                      width: 28px;
                      height: 28px;
                      border-radius: 50%;
                      background: rgba(255, 255, 255, 0.08);
                      border: 1px solid rgba(255, 255, 255, 0.15);
                      color: #ffffff;
                      display: flex;
                      align-items: center;
                      justify-content: center;
                      font-size: 0.76rem;
                      font-weight: 800;
                      flex-shrink: 0;
                    "
                  >
                    @(string.IsNullOrEmpty(emp.Name) ? "U" : emp.Name.Substring(0, 1).ToUpper())
                  </div>
                  <span style="font-size: 0.88rem; font-weight: 600; color: #e2e8f0;">
                    @emp.Name
                  </span>
                </div>
                <span style="font-size: 0.76rem; color: #38bdf8; font-family: 'JetBrains Mono', monospace;">
                  @emp.Npk
                </span>
              </div>
            }
          </div>
        </div>

        <!-- Hidden input for selected employee npks -->
        <input type="hidden" name="npks" id="selectedNpkHidden" required />
        <input type="hidden" name="employeeName" id="selectedNameHidden" />

        <!-- Quick chips -->
        <div id="quickChipsContainer" style="display: flex; gap: 6px; flex-wrap: wrap; margin-top: 8px;">
          @foreach (var emp in Model.AvailableEmployees.Take(8))
          {
            <button
              type="button"
              onclick="selectEmployee('@emp.Name', '@emp.Npk', '@emp.Plant', '@(emp.Shift ?? "Shift 1")');"
              style="
                background-color: rgba(255, 255, 255, 0.04);
                border: 1px solid rgba(140, 193, 233, 0.18);
                color: #8CC1E9;
                font-size: 0.78rem;
                font-weight: 500;
                padding: 4px 10px;
                border-radius: 6px;
                cursor: pointer;
              "
            >
              @emp.Name
            </button>
          }
        </div>
      </div>

      <!-- ROW: NPK & SHIFT -->
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
        <!-- 3. NPK -->
        <div class="form-group" style="margin-bottom: 0;">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; min-height: 22px;">
            <label class="form-label" style="font-size: 0.86rem; font-weight: 800; color: #FFF8E7; letter-spacing: 0.04em; margin-bottom: 0;">
              <i data-lucide="file-text" style="width: 15px; height: 15px; display: inline; margin-right: 6px; color: #00d2ff;"></i>
              NPK
            </label>
            <span style="font-size: 0.72rem; color: #34d399; font-weight: 700; background: rgba(52, 211, 153, 0.12); padding: 2px 8px; border-radius: 4px; border: 1px solid rgba(52, 211, 153, 0.25);">
              ✓ Terisi Otomatis
            </span>
          </div>
          <input
            type="text"
            id="npkDisplayInput"
            placeholder="NPK Karyawan"
            readonly
            style="
              width: 100%;
              padding: 0 16px;
              font-size: 0.92rem;
              background: rgba(10, 22, 45, 0.85);
              border-radius: 8px;
              font-family: 'JetBrains Mono', monospace;
              font-weight: 700;
              height: 44px;
              border: 1px solid rgba(67, 139, 196, 0.35);
              color: #FFF8E7;
              box-sizing: border-box;
            "
          />
        </div>

        <!-- 4. SHIFT SELECTION -->
        <div class="form-group" style="margin-bottom: 0;">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; min-height: 22px;">
            <label class="form-label" style="font-size: 0.85rem; font-weight: 800; color: #FFF8E7; letter-spacing: 0.04em; margin-bottom: 0; white-space: nowrap;">
              <i data-lucide="layers" style="width: 15px; height: 15px; display: inline; margin-right: 6px; color: #00d2ff;"></i>
              PILIH SHIFT
            </label>
            <span id="shiftTimeBadge" style="font-size: 0.72rem; color: #818cf8; font-weight: 700; background: rgba(129, 140, 248, 0.15); padding: 2px 8px; border-radius: 4px; border: 1px solid rgba(129, 140, 248, 0.35); white-space: nowrap;">
              22:30 - 07:30 (Malam)
            </span>
          </div>
          <input type="hidden" name="shiftName" id="shiftNameHidden" value="Shift 1" />
          <div
            style="
              display: grid;
              grid-template-columns: 1fr 1fr;
              gap: 6px;
              height: 44px;
              background: rgba(10, 22, 45, 0.85);
              padding: 4px;
              border-radius: 8px;
              border: 1px solid rgba(67, 139, 196, 0.35);
              box-sizing: border-box;
            "
          >
            <button
              type="button"
              id="shiftBtn1"
              onclick="setShift('Shift 1');"
              style="
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 6px;
                height: 100%;
                border-radius: 6px;
                border: 1px solid #818cf8;
                background: linear-gradient(135deg, rgba(79, 70, 229, 0.45) 0%, rgba(129, 140, 248, 0.3) 100%);
                color: #c7d2fe;
                font-weight: 800;
                font-size: 0.88rem;
                cursor: pointer;
                transition: all 0.2s;
              "
            >
              <i data-lucide="moon" style="width: 14px; height: 14px;"></i>
              <span>Shift 1 (Malam)</span>
            </button>
            <button
              type="button"
              id="shiftBtn2"
              onclick="setShift('Shift 2');"
              style="
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 6px;
                height: 100%;
                border-radius: 6px;
                border: 1px solid transparent;
                background: transparent;
                color: #8CC1E9;
                font-weight: 600;
                font-size: 0.88rem;
                cursor: pointer;
                transition: all 0.2s;
              "
            >
              <i data-lucide="sun" style="width: 14px; height: 14px;"></i>
              <span>Shift 2 (Pagi)</span>
            </button>
          </div>
        </div>
      </div>

      <!-- ROW: TGL OVERTIME & JAM / WAKTU OVERTIME -->
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
        <!-- 5. TGL OVERTIME & TIPE HARI -->
        <div class="form-group" style="margin-bottom: 0;">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; min-height: 22px;">
            <label class="form-label" style="font-size: 0.85rem; font-weight: 800; color: #FFF8E7; letter-spacing: 0.04em; margin-bottom: 0; white-space: nowrap;">
              <i data-lucide="calendar" style="width: 15px; height: 15px; display: inline; margin-right: 6px; color: #00d2ff;"></i>
              TGL SHIFT / LEMBUR
            </label>
            <div style="display: flex; gap: 4px;">
              <button
                type="button"
                id="dotBtn"
                onclick="setDayType(false);"
                style="padding: 2px 8px; border-radius: 4px; font-size: 0.72rem; font-weight: 800; cursor: pointer; border: 1px solid #00d2ff; background: rgba(0, 136, 255, 0.4); color: #FFF8E7;"
                title="D.O.T (Hari Kerja: Jam 1: 1.5x, Jam 2+: 2.0x)"
              >
                D.O.T
              </button>
              <button
                type="button"
                id="hotBtn"
                onclick="setDayType(true);"
                style="padding: 2px 8px; border-radius: 4px; font-size: 0.72rem; font-weight: 800; cursor: pointer; border: 1px solid rgba(67, 139, 196, 0.3); background: rgba(10, 22, 45, 0.6); color: #8CC1E9;"
                title="H.O.T (Hari Libur: Jam 1-7: 2x, Jam 8: 3x, Jam 9+: 4x)"
              >
                H.O.T
              </button>
            </div>
          </div>
          <input type="hidden" name="isHoliday" id="isHolidayHidden" value="false" />
          <input
            type="date"
            name="workDate"
            id="workDateInput"
            value="@Model.DefaultDate"
            required
            style="
              width: 100%;
              padding: 0 14px;
              font-size: 0.92rem;
              background: rgba(10, 22, 45, 0.85);
              border-radius: 8px;
              height: 44px;
              border: 1px solid rgba(67, 139, 196, 0.35);
              color: #FFF8E7;
              color-scheme: dark;
              box-sizing: border-box;
            "
            onchange="recalculatePreview();"
          />
        </div>

        <!-- 6. JAM / WAKTU (ACTUAL) -->
        <div class="form-group" style="margin-bottom: 0;">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; min-height: 22px;">
            <label class="form-label" style="font-size: 0.85rem; font-weight: 800; color: #FFF8E7; letter-spacing: 0.04em; margin-bottom: 0; white-space: nowrap;">
              <i data-lucide="clock" style="width: 15px; height: 15px; display: inline; margin-right: 6px; color: #00d2ff;"></i>
              RENTANG JAM LEMBUR
            </label>
            <span id="durationStatusBadge" style="font-size: 0.72rem; color: #34d399; font-weight: 700; background: rgba(52, 211, 153, 0.12); padding: 2px 8px; border-radius: 4px; border: 1px solid rgba(52, 211, 153, 0.3); white-space: nowrap;">
              120 Menit Total
            </span>
          </div>

          <div style="display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 10px; height: 44px;">
            <div style="display: flex; align-items: center; justify-content: space-between; background: rgba(10, 22, 45, 0.95); border: 1.5px solid rgba(67, 139, 196, 0.45); border-radius: 8px; height: 44px; padding: 0 10px; box-sizing: border-box;">
              <span style="font-size: 0.78rem; color: #8CC1E9; font-weight: 800; white-space: nowrap;">Mulai:</span>
              <input type="time" name="jamMasuk" id="jamMasukInput" value="07:30" onchange="recalculatePreview();" style="background: transparent; border: none; color: #FFF8E7; font-size: 0.95rem; font-weight: 800; font-family: 'JetBrains Mono', monospace; outline: none;" />
            </div>

            <span style="color: #00d2ff; font-weight: 800; font-size: 0.95rem;">→</span>

            <div style="display: flex; align-items: center; justify-content: space-between; background: rgba(10, 22, 45, 0.95); border: 1.5px solid rgba(67, 139, 196, 0.45); border-radius: 8px; height: 44px; padding: 0 10px; box-sizing: border-box;">
              <span style="font-size: 0.78rem; color: #8CC1E9; font-weight: 800; white-space: nowrap;">Selesai:</span>
              <input type="time" name="jamPulang" id="jamPulangInput" value="09:30" onchange="recalculatePreview();" style="background: transparent; border: none; color: #FFF8E7; font-size: 0.95rem; font-weight: 800; font-family: 'JetBrains Mono', monospace; outline: none;" />
            </div>
          </div>
        </div>
      </div>

      <!-- 7. REALTIME OVERTIME VALIDATION & CALCULATION SUMMARY CARD -->
      <div
        id="calcCard"
        style="
          background-color: rgba(9, 26, 56, 0.95);
          border: 1.5px solid rgba(0, 210, 255, 0.45);
          border-radius: 14px;
          padding: 18px 24px;
          display: flex;
          flex-direction: column;
          gap: 12px;
          box-shadow: 0 6px 20px rgba(0, 0, 0, 0.35);
        "
      >
        <!-- Header Validation Result -->
        <div style="display: flex; align-items: center; justify-content: space-between;">
          <div style="display: flex; align-items: center; gap: 8px;">
            <i data-lucide="check-circle-2" id="calcStatusIcon" style="width: 20px; height: 20px; color: #10b981;"></i>
            <span id="calcStatusText" style="font-size: 0.94rem; font-weight: 800; color: #FFF8E7;">
              STATUS: SAH (LEMBUR SETELAH SHIFT)
            </span>
          </div>

          <span style="font-size: 0.76rem; color: #8CC1E9; font-weight: 700;">
            Kalkulasi Otomatis Sesuai Regulasi
          </span>
        </div>

        <!-- Metrics Row -->
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px; padding-top: 6px; border-top: 1px solid rgba(67, 139, 196, 0.25);">
          <!-- Durasi Jam Lembur -->
          <div style="background: rgba(10, 22, 45, 0.75); border: 1px solid rgba(67, 139, 196, 0.3); border-radius: 10px; padding: 12px 16px;">
            <div style="font-size: 0.76rem; color: #94a3b8; font-weight: 700; text-transform: uppercase;">Durasi Jam Lembur</div>
            <div style="display: flex; align-items: baseline; gap: 6px; margin-top: 4px;">
              <span id="previewJamVal" style="font-size: 1.65rem; font-weight: 900; color: #FFF8E7; font-family: 'Outfit', sans-serif;">2.0</span>
              <span style="font-size: 0.9rem; color: #8CC1E9; font-weight: 700;">Jam</span>
            </div>
          </div>

          <!-- Total TUL -->
          <div style="background: rgba(10, 22, 45, 0.75); border: 1px solid rgba(251, 191, 36, 0.4); border-radius: 10px; padding: 12px 16px;">
            <div style="font-size: 0.76rem; color: #fbbf24; font-weight: 700; text-transform: uppercase;">Total TUL (Tunjangan Uang Lembur)</div>
            <div style="display: flex; align-items: baseline; gap: 6px; margin-top: 4px;">
              <span id="previewTulVal" style="font-size: 1.65rem; font-weight: 900; color: #fbbf24; font-family: 'Outfit', sans-serif;">3.5</span>
              <span style="font-size: 0.9rem; color: #fbbf24; font-weight: 700;">TUL</span>
            </div>
          </div>
        </div>

        <!-- Formula Breakdown -->
        <div style="font-size: 0.78rem; color: #8CC1E9; display: flex; align-items: center; gap: 6px;">
          <i data-lucide="calculator" style="width: 14px; height: 14px; color: #00d2ff;"></i>
          <span>Rincian Formula:</span>
          <strong id="previewFormulaBreakdown" style="color: #FFF8E7;">(1 jam × 1.5) + (1 jam × 2.0) = 3.5 TUL</strong>
        </div>
      </div>

      <!-- 8. ACTION BUTTONS -->
      <div style="display: flex; gap: 12px; margin-top: 8px;">
        <button
          type="reset"
          onclick="resetInputForm();"
          style="
            flex: 1;
            height: 48px;
            background: rgba(10, 22, 45, 0.8);
            border: 1px solid rgba(67, 139, 196, 0.4);
            border-radius: 10px;
            color: #8CC1E9;
            font-size: 0.92rem;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.15s ease;
          "
        >
          Reset Formulir
        </button>

        <button
          type="submit"
          id="submitOvertimeBtn"
          style="
            flex: 2;
            height: 48px;
            background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);
            border: none;
            border-radius: 10px;
            color: #ffffff;
            font-size: 1rem;
            font-weight: 800;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            box-shadow: 0 4px 16px rgba(2, 132, 199, 0.35);
            transition: all 0.2s ease;
          "
        >
          <span>Simpan Data Lembur QC</span>
          <i data-lucide="send" style="width: 16px; height: 16px;"></i>
        </button>
      </div>

    </div>
  </form>

</div>

@section Scripts {
<script>
  // Live Clock
  function updateInputLiveClock() {
    var now = new Date();
    var months = ['Jan', 'Feb', 'Mar', 'Apr', 'Mei', 'Jun', 'Jul', 'Agu', 'Sep', 'Okt', 'Nov', 'Des'];
    var d = String(now.getDate()).padStart(2, '0');
    var m = months[now.getMonth()];
    var y = now.getFullYear();
    var h = String(now.getHours()).padStart(2, '0');
    var min = String(now.getMinutes()).padStart(2, '0');
    var s = String(now.getSeconds()).padStart(2, '0');
    var el = document.getElementById('inputLiveClock');
    if (el) el.innerText = d + ' ' + m + ' ' + y + '  ' + h + ':' + min + ':' + s;
  }
  updateInputLiveClock();
  setInterval(updateInputLiveClock, 1000);

  // Employee Dropdown handling
  var isDropdownOpen = false;
  function toggleEmpDropdown() {
    isDropdownOpen = !isDropdownOpen;
    var popup = document.getElementById('empDropdownPopup');
    var chev = document.getElementById('empDropdownChevron');
    if (popup) popup.style.display = isDropdownOpen ? 'block' : 'none';
    if (chev) chev.style.transform = isDropdownOpen ? 'rotate(180deg)' : 'rotate(0deg)';
    if (isDropdownOpen) {
      document.getElementById('empSearchInput').focus();
    }
  }

  function filterEmpList() {
    var q = document.getElementById('empSearchInput').value.toLowerCase();
    var items = document.querySelectorAll('.emp-option-item');
    items.forEach(function(item) {
      var name = item.getAttribute('data-name').toLowerCase();
      var npk = item.getAttribute('data-npk').toLowerCase();
      item.style.display = (name.includes(q) || npk.includes(q)) ? 'flex' : 'none';
    });
  }

  function selectEmployee(name, npk, plant, shift) {
    document.getElementById('selectedNpkHidden').value = npk;
    document.getElementById('selectedNameHidden').value = name;
    document.getElementById('npkDisplayInput').value = npk;
    document.getElementById('selectedEmpDisplay').innerText = name + ' (' + npk + ')';
    document.getElementById('selectedEmpDisplay').style.color = '#FFF8E7';

    if (plant) {
      var pSelect = document.getElementById('plantSelect');
      for (var i = 0; i < pSelect.options.length; i++) {
        if (pSelect.options[i].value === plant) {
          pSelect.selectedIndex = i;
          break;
        }
      }
    }
    if (shift) {
      setShift(shift);
    }
    if (isDropdownOpen) {
      toggleEmpDropdown();
    }
  }

  function onPlantChange() {
    var plant = document.getElementById('plantSelect').value;
    var items = document.querySelectorAll('.emp-option-item');
    var count = 0;
    items.forEach(function(item) {
      var p = item.getAttribute('data-plant');
      if (!plant || p === plant) {
        item.style.display = 'flex';
        count++;
      } else {
        item.style.display = 'none';
      }
    });
    document.getElementById('employeeCountBadge').innerText = count + ' Karyawan (' + (plant || 'Semua') + ')';
  }

  // Shift selection
  function setShift(shift) {
    document.getElementById('shiftNameHidden').value = shift;
    var isS1 = shift === 'Shift 1';
    var b1 = document.getElementById('shiftBtn1');
    var b2 = document.getElementById('shiftBtn2');
    var badge = document.getElementById('shiftTimeBadge');

    if (isS1) {
      b1.style.border = '1px solid #818cf8';
      b1.style.background = 'linear-gradient(135deg, rgba(79, 70, 229, 0.45) 0%, rgba(129, 140, 248, 0.3) 100%)';
      b1.style.color = '#c7d2fe';

      b2.style.border = '1px solid transparent';
      b2.style.background = 'transparent';
      b2.style.color = '#8CC1E9';

      badge.innerText = '22:30 - 07:30 (Malam)';
      badge.style.color = '#818cf8';
      badge.style.background = 'rgba(129, 140, 248, 0.15)';
      badge.style.borderColor = 'rgba(129, 140, 248, 0.35)';

      // Defaults for shift 1 overtime
      document.getElementById('jamMasukInput').value = '07:30';
      document.getElementById('jamPulangInput').value = '09:30';
    } else {
      b2.style.border = '1px solid #38bdf8';
      b2.style.background = 'linear-gradient(135deg, rgba(2, 132, 199, 0.45) 0%, rgba(56, 189, 248, 0.3) 100%)';
      b2.style.color = '#bae6fd';

      b1.style.border = '1px solid transparent';
      b1.style.background = 'transparent';
      b1.style.color = '#8CC1E9';

      badge.innerText = '07:30 - 16:30 (Pagi)';
      badge.style.color = '#38bdf8';
      badge.style.background = 'rgba(56, 189, 248, 0.15)';
      badge.style.borderColor = 'rgba(56, 189, 248, 0.35)';

      // Defaults for shift 2 overtime
      document.getElementById('jamMasukInput').value = '16:30';
      document.getElementById('jamPulangInput').value = '18:30';
    }
    recalculatePreview();
  }

  // Day type: DOT vs HOT
  function setDayType(isHoliday) {
    document.getElementById('isHolidayHidden').value = isHoliday ? 'true' : 'false';
    var dot = document.getElementById('dotBtn');
    var hot = document.getElementById('hotBtn');

    if (isHoliday) {
      hot.style.border = '1px solid #fbbf24';
      hot.style.background = 'rgba(245, 158, 11, 0.35)';
      hot.style.color = '#fbbf24';

      dot.style.border = '1px solid rgba(67, 139, 196, 0.3)';
      dot.style.background = 'rgba(10, 22, 45, 0.6)';
      dot.style.color = '#8CC1E9';
    } else {
      dot.style.border = '1px solid #00d2ff';
      dot.style.background = 'rgba(0, 136, 255, 0.4)';
      dot.style.color = '#FFF8E7';

      hot.style.border = '1px solid rgba(67, 139, 196, 0.3)';
      hot.style.background = 'rgba(10, 22, 45, 0.6)';
      hot.style.color = '#8CC1E9';
    }
    recalculatePreview();
  }

  // Recalculate duration and TUL client-side
  function recalculatePreview() {
    var inVal = document.getElementById('jamMasukInput').value;
    var outVal = document.getElementById('jamPulangInput').value;
    var isHoliday = document.getElementById('isHolidayHidden').value === 'true';

    if (!inVal || !outVal) return;

    var inParts = inVal.split(':');
    var outParts = outVal.split(':');
    var inMin = parseInt(inParts[0]) * 60 + parseInt(inParts[1]);
    var outMin = parseInt(outParts[0]) * 60 + parseInt(outParts[1]);

    if (outMin < inMin) {
      outMin += 24 * 60; // Next day wrap
    }

    var totalMin = outMin - inMin;
    var rawHours = Math.round((totalMin / 60) * 10) / 10;

    document.getElementById('durationStatusBadge').innerText = totalMin + ' Menit Total';

    // Calculate TUL
    var tul = 0;
    var breakdown = '';
    if (!isHoliday) {
      // D.O.T
      if (rawHours <= 1) {
        tul = rawHours * 1.5;
        breakdown = rawHours + ' jam × 1.5 = ' + tul.toFixed(1) + ' TUL';
      } else {
        tul = 1.5 + (rawHours - 1) * 2.0;
        breakdown = '(1 jam × 1.5) + (' + (rawHours - 1).toFixed(1) + ' jam × 2.0) = ' + tul.toFixed(1) + ' TUL';
      }
    } else {
      // H.O.T
      if (rawHours <= 7) {
        tul = rawHours * 2.0;
        breakdown = rawHours + ' jam × 2.0 = ' + tul.toFixed(1) + ' TUL';
      } else if (rawHours <= 8) {
        tul = 14 + (rawHours - 7) * 3.0;
        breakdown = '(7 jam × 2.0) + (' + (rawHours - 7).toFixed(1) + ' jam × 3.0) = ' + tul.toFixed(1) + ' TUL';
      } else {
        tul = 17 + (rawHours - 8) * 4.0;
        breakdown = '(7 jam × 2.0) + (1 jam × 3.0) + (' + (rawHours - 8).toFixed(1) + ' jam × 4.0) = ' + tul.toFixed(1) + ' TUL';
      }
    }

    document.getElementById('previewJamVal').innerText = rawHours.toFixed(1);
    document.getElementById('previewTulVal').innerText = tul.toFixed(1);
    document.getElementById('previewFormulaBreakdown').innerText = breakdown;
  }

  function resetInputForm() {
    document.getElementById('overtimeForm').reset();
    setShift('Shift 1');
    setDayType(false);
    recalculatePreview();
  }

  // Close dropdown on clicking outside
  document.addEventListener('click', function(e) {
    var trigger = document.getElementById('empSelectorTrigger');
    var popup = document.getElementById('empDropdownPopup');
    if (trigger && popup && !trigger.contains(e.target) && !popup.contains(e.target)) {
      if (isDropdownOpen) toggleEmpDropdown();
    }
  });

  // Initial calculation
  recalculatePreview();
</script>
}
