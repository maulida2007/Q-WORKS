@model RiwayatPenginputViewModel
@inject IAuthService AuthService
@{
    ViewData["Title"] = "Riwayat Penginput Data Lembur";
    Layout = "_Layout";
    var currentUser = AuthService.GetCurrentUser();
    bool isAdmin = currentUser?.IsAdmin == true;

    double totalJam = Model.Records.Sum(r => r.JamOvertime);
    double totalTul = Model.Records.Sum(r => r.TotalTul);
    int totalSubmitters = Model.Records.Select(r => r.CreatedByNpk).Distinct().Count();

    Func<string, (string bg, string text, string border)> getPlantBadgeStyle = (plantName) => {
        var p = (plantName ?? "").ToLower();
        if (p.Contains("hose")) return ("rgba(244, 63, 94, 0.15)", "#fb7185", "1px solid rgba(244, 63, 94, 0.35)");
        if (p.Contains("molded")) return ("rgba(56, 189, 248, 0.15)", "#38bdf8", "1px solid rgba(56, 189, 248, 0.35)");
        if (p.Contains("subcont")) return ("rgba(16, 185, 129, 0.15)", "#34d399", "1px solid rgba(16, 185, 129, 0.35)");
        if (p.Contains("lab") || p.Contains("mixing")) return ("rgba(245, 158, 11, 0.15)", "#fbbf24", "1px solid rgba(245, 158, 11, 0.35)");
        if (p.Contains("rvi")) return ("rgba(168, 85, 247, 0.15)", "#c084fc", "1px solid rgba(168, 85, 247, 0.35)");
        if (p.Contains("qre")) return ("rgba(6, 182, 212, 0.15)", "#22d3ee", "1px solid rgba(6, 182, 212, 0.35)");
        return ("rgba(148, 163, 184, 0.15)", "#cbd5e1", "1px solid rgba(148, 163, 184, 0.3)");
    };

    var riwayatMonthSlicer = new SlicerViewModel
    {
        Id = "slicerRiwayatMonths",
        Name = "months",
        Title = "BULAN",
        HeaderTitle = "Bulan",
        Items = Model.MonthList.Select(m => {
            var parts = m.Split(' ');
            return new SlicerItemViewModel
            {
                Value = m,
                MainText = parts.Length > 0 ? parts[0] : m,
                SubText = parts.Length > 1 ? parts[1] : "",
                IsChecked = Model.SelectedMonths.Any(sm => sm.Equals(m, StringComparison.OrdinalIgnoreCase) || DashboardController.NormalizeToIndonesianMonth(sm).Equals(m, StringComparison.OrdinalIgnoreCase))
            };
        }).ToList()
    };

    var riwayatDaySlicer = new SlicerViewModel
    {
        Id = "slicerRiwayatDays",
        Name = "days",
        Title = "TANGGAL",
        HeaderTitle = "Tanggal",
        Items = Model.DayList.Select(d => new SlicerItemViewModel
        {
            Value = d,
            MainText = $"Tanggal {d}",
            SubText = "",
            IsChecked = Model.SelectedDays.Contains(d)
        }).ToList()
    };

    var riwayatShiftSlicer = new SlicerViewModel
    {
        Id = "slicerRiwayatShifts",
        Name = "shifts",
        Title = "SHIFT",
        HeaderTitle = "Shift",
        Items = Model.ShiftList.Select(s => new SlicerItemViewModel
        {
            Value = s,
            MainText = s,
            SubText = "",
            IsChecked = Model.SelectedShifts.Contains(s) || (s.Contains("1") && Model.SelectedShifts.Contains("1")) || (s.Contains("2") && Model.SelectedShifts.Contains("2"))
        }).ToList()
    };

    var riwayatPlantSlicer = new SlicerViewModel
    {
        Id = "slicerRiwayatPlants",
        Name = "plants",
        Title = "PLANT",
        HeaderTitle = "Plant",
        AlignRight = true,
        Items = Model.PlantList.Select(p => new SlicerItemViewModel
        {
            Value = p,
            MainText = p,
            SubText = "",
            IsChecked = Model.SelectedPlants.Contains(p) || Model.SelectedPlants.Any(sp => sp.Equals(p, StringComparison.OrdinalIgnoreCase) || p.IndexOf(sp, StringComparison.OrdinalIgnoreCase) >= 0 || sp.IndexOf(p, StringComparison.OrdinalIgnoreCase) >= 0)
        }).ToList()
    };

    var riwayatEmpSlicer = new SlicerViewModel
    {
        Id = "slicerRiwayatEmployees",
        Name = "employees",
        Title = "KARYAWAN",
        HeaderTitle = "Karyawan",
        AlignRight = true,
        Items = Model.EmployeeList.Select(e => new SlicerItemViewModel
        {
            Value = e.Name,
            MainText = e.Name,
            SubText = !string.IsNullOrEmpty(e.Nik) ? $"NPK: {e.Nik}" : "",
            IsChecked = Model.SelectedEmployees.Contains(e.Name) || (!string.IsNullOrEmpty(e.Nik) && Model.SelectedEmployees.Contains(e.Nik))
        }).ToList()
    };
}

<div class="page-content" style="max-width: 1600px; margin: 0 auto; display: flex; flex-direction: column; gap: 16px;">

  <!-- 1. PAGE HEADER -->
  <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px; margin-bottom: 6px; padding-bottom: 16px; border-bottom: 1px solid rgba(255, 255, 255, 0.08);">
    <div style="display: flex; align-items: center; gap: 14px;">
      <div style="width: 44px; height: 44px; border-radius: 12px; background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%); display: flex; align-items: center; justify-content: center; box-shadow: 0 4px 14px rgba(2, 132, 199, 0.3);">
        <i data-lucide="history" style="width: 22px; height: 22px; color: #ffffff;"></i>
      </div>
      <div>
        <h1 style="margin: 0; font-size: 1.35rem; font-weight: 800; color: #f8fafc; letter-spacing: 0.02em;">
          Riwayat Penginput Data Lembur
        </h1>
        <p style="margin: 3px 0 0; font-size: 0.84rem; color: #94a3b8;">
          Audit trail log penginputan lembur QC sesuai spesifikasi 10 kolom resmi
        </p>
      </div>
    </div>

    <!-- Live Clock Pill -->
    <div style="display: flex; align-items: center; gap: 8px; background: rgba(9, 24, 52, 0.7); border: 1px solid rgba(56, 189, 248, 0.2); border-radius: 10px; padding: 8px 14px;">
      <i data-lucide="clock" style="width: 15px; height: 15px; color: #38bdf8;"></i>
      <span id="riwayatLiveClock" style="font-size: 0.82rem; font-weight: 600; color: #cbd5e1; font-family: 'JetBrains Mono', monospace;">
        --
      </span>
    </div>
  </div>

  <!-- 2. STATISTIC SUMMARY CARDS -->
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 14px;">
    <!-- Card 1: Total Transaksi -->
    <div style="background: rgba(9, 24, 52, 0.75); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 12px; padding: 14px 18px; display: flex; align-items: center; gap: 14px;">
      <div style="width: 42px; height: 42px; border-radius: 10px; background: rgba(14, 165, 233, 0.12); border: 1px solid rgba(56, 189, 248, 0.25); display: flex; align-items: center; justify-content: center; color: #38bdf8;">
        <i data-lucide="file-text" style="width: 20px; height: 20px;"></i>
      </div>
      <div>
        <div style="font-size: 0.76rem; color: #94a3b8; font-weight: 600;">Total Transaksi</div>
        <div style="font-size: 1.45rem; font-weight: 800; color: #f8fafc; line-height: 1.2;">
          @Model.TotalRecords
        </div>
      </div>
    </div>

    <!-- Card 2: Penginput Unik -->
    <div style="background: rgba(9, 24, 52, 0.75); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 12px; padding: 14px 18px; display: flex; align-items: center; gap: 14px;">
      <div style="width: 42px; height: 42px; border-radius: 10px; background: rgba(16, 185, 129, 0.12); border: 1px solid rgba(16, 185, 129, 0.25); display: flex; align-items: center; justify-content: center; color: #34d399;">
        <i data-lucide="users" style="width: 20px; height: 20px;"></i>
      </div>
      <div>
        <div style="font-size: 0.76rem; color: #94a3b8; font-weight: 600;">User Penginput</div>
        <div style="font-size: 1.45rem; font-weight: 800; color: #34d399; line-height: 1.2;">
          @totalSubmitters
        </div>
      </div>
    </div>

    <!-- Card 3: Total Jam Lembur -->
    <div style="background: rgba(9, 24, 52, 0.75); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 12px; padding: 14px 18px; display: flex; align-items: center; gap: 14px;">
      <div style="width: 42px; height: 42px; border-radius: 10px; background: rgba(245, 158, 11, 0.12); border: 1px solid rgba(245, 158, 11, 0.25); display: flex; align-items: center; justify-content: center; color: #fbbf24;">
        <i data-lucide="clock" style="width: 20px; height: 20px;"></i>
      </div>
      <div>
        <div style="font-size: 0.76rem; color: #94a3b8; font-weight: 600;">Total Jam Lembur</div>
        <div style="font-size: 1.45rem; font-weight: 800; color: #fbbf24; line-height: 1.2;">
          @totalJam.ToString("N1") <span style="font-size: 0.82rem; font-weight: 600; color: #94a3b8;">Jam</span>
        </div>
      </div>
    </div>

    <!-- Card 4: Total TUL Lembur -->
    <div style="background: rgba(9, 24, 52, 0.75); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 12px; padding: 14px 18px; display: flex; align-items: center; gap: 14px;">
      <div style="width: 42px; height: 42px; border-radius: 10px; background: rgba(52, 211, 153, 0.12); border: 1px solid rgba(52, 211, 153, 0.25); display: flex; align-items: center; justify-content: center; color: #34d399;">
        <i data-lucide="layers" style="width: 20px; height: 20px;"></i>
      </div>
      <div>
        <div style="font-size: 0.76rem; color: #94a3b8; font-weight: 600;">Total TUL Lembur</div>
        <div style="font-size: 1.45rem; font-weight: 800; color: #34d399; line-height: 1.2;">
          @totalTul.ToString("N1") <span style="font-size: 0.82rem; font-weight: 600; color: #94a3b8;">TUL</span>
        </div>
      </div>
    </div>
  </div>

  <!-- 3. FILTER PARAMETER CARD (5 SLICERS: BULAN, TANGGAL, SHIFT, PLANT, KARYAWAN) -->
  <div class="filter-parameter-mockup-card" style="margin-bottom: 0;">
    <div class="filter-parameter-top-row">
      <div class="filter-parameter-title-group">
        <i data-lucide="filter" style="width: 16px; height: 16px; color: #8CC1E9;"></i>
        <span class="filter-param-header-text">Filter Riwayat Penginput (AND Logic)</span>
        <span class="filter-live-pill">Live Filter</span>
      </div>
      <div class="filter-parameter-actions">
        <a href="/RiwayatPenginput" class="btn-filter-reset" title="Kembalikan semua filter ke kondisi awal">
          <i data-lucide="rotate-ccw" style="width: 14px; height: 14px;"></i>
          <span>Reset Filter</span>
        </a>
        @if (isAdmin)
        {
          <a href="/RiwayatPenginput/ExportExcel@(Context.Request.QueryString)" class="btn-filter-export" title="Unduh file Excel 10 Kolom Resmi">
            <i data-lucide="download" style="width: 14px; height: 14px;"></i>
            <span>Ekspor Excel (.xlsx)</span>
          </a>
        }
      </div>
    </div>

    <!-- Slicers Form -->
    <form id="riwayatFilterForm" method="get" action="/RiwayatPenginput" class="filter-slicer-grid">
      @if (!string.IsNullOrEmpty(Model.SearchKeyword))
      {
        <input type="hidden" name="search" value="@Model.SearchKeyword" />
      }
      @await Html.PartialAsync("_SlicerDropdown", riwayatMonthSlicer)
      @await Html.PartialAsync("_SlicerDropdown", riwayatDaySlicer)
      @await Html.PartialAsync("_SlicerDropdown", riwayatShiftSlicer)
      @await Html.PartialAsync("_SlicerDropdown", riwayatPlantSlicer)
      @await Html.PartialAsync("_SlicerDropdown", riwayatEmpSlicer)
    </form>

    <!-- Search input row -->
    <div style="display: flex; align-items: center; gap: 10px; margin-top: 10px; padding-top: 10px; border-top: 1px solid rgba(255, 255, 255, 0.05);">
      <div style="position: relative; flex: 1; max-width: 400px;">
        <i data-lucide="search" style="width: 15px; height: 15px; color: #64748b; position: absolute; left: 12px; top: 12px;"></i>
        <input
          type="text"
          form="riwayatFilterForm"
          name="search"
          value="@Model.SearchKeyword"
          placeholder="Cari penginput, nama pekerja, NPK..."
          style="width: 100%; padding: 9px 12px 9px 36px; background: rgba(5, 12, 26, 0.9); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 7px; color: #ffffff; font-size: 0.84rem; outline: none; box-sizing: border-box;"
        />
      </div>
      <button type="submit" form="riwayatFilterForm" style="padding: 9px 16px; border-radius: 7px; background: rgba(56, 189, 248, 0.15); border: 1px solid rgba(56, 189, 248, 0.35); color: #38bdf8; font-size: 0.84rem; font-weight: 700; cursor: pointer;">
        Cari
      </button>
    </div>
  </div>

  <!-- 4. TABEL AUDIT LOG RESMI (10 KOLOM SPESIFIKASI Q-WORKS) -->
  <div style="background: rgba(8, 18, 38, 0.75); border: 1px solid rgba(255, 255, 255, 0.07); border-radius: 10px; overflow: hidden;">
    <!-- Table Header Bar -->
    <div style="padding: 12px 18px; border-bottom: 1px solid rgba(255, 255, 255, 0.06); display: flex; align-items: center; justify-content: space-between;">
      <div style="display: flex; align-items: center; gap: 8px;">
        <i data-lucide="history" style="width: 16px; height: 16px; color: #38bdf8;"></i>
        <span style="font-weight: 700; color: #f8fafc; font-size: 0.90rem;">
          Daftar Riwayat Transaksi (@Model.Records.Count Data)
        </span>
      </div>
      <span style="font-size: 0.78rem; color: #64748b;">
        Audit trail tersimpan permanen
      </span>
    </div>

    <!-- Table Body -->
    <div style="overflow-x: auto;">
      <table style="width: 100%; border-collapse: collapse; font-size: 0.84rem; min-width: 1100px;">
        <thead>
          <tr style="background: rgba(5, 12, 26, 0.85); border-bottom: 1px solid rgba(255, 255, 255, 0.08);">
            <th style="padding: 11px 10px; color: #94a3b8; font-weight: 700; font-size: 0.78rem; letter-spacing: 0.02em; text-align: left;">Waktu Input</th>
            <th style="padding: 11px 10px; color: #94a3b8; font-weight: 700; font-size: 0.78rem; letter-spacing: 0.02em; text-align: center;">Role Penginput</th>
            <th style="padding: 11px 10px; color: #94a3b8; font-weight: 700; font-size: 0.78rem; letter-spacing: 0.02em; text-align: left;">Plant</th>
            <th style="padding: 11px 10px; color: #94a3b8; font-weight: 700; font-size: 0.78rem; letter-spacing: 0.02em; text-align: left;">Nama Karyawan</th>
            <th style="padding: 11px 10px; color: #94a3b8; font-weight: 700; font-size: 0.78rem; letter-spacing: 0.02em; text-align: center;">NPK</th>
            <th style="padding: 11px 10px; color: #94a3b8; font-weight: 700; font-size: 0.78rem; letter-spacing: 0.02em; text-align: left;">Plant Karyawan</th>
            <th style="padding: 11px 10px; color: #94a3b8; font-weight: 700; font-size: 0.78rem; letter-spacing: 0.02em; text-align: center;">Shift</th>
            <th style="padding: 11px 10px; color: #94a3b8; font-weight: 700; font-size: 0.78rem; letter-spacing: 0.02em; text-align: center;">Tanggal Lembur</th>
            <th style="padding: 11px 10px; color: #94a3b8; font-weight: 700; font-size: 0.78rem; letter-spacing: 0.02em; text-align: right;">Jam Lembur</th>
            <th style="padding: 11px 10px; color: #94a3b8; font-weight: 700; font-size: 0.78rem; letter-spacing: 0.02em; text-align: right;">Total TUL</th>
          </tr>
        </thead>
        <tbody>
          @if (Model.Records.Count == 0)
          {
            <tr>
              <td colspan="10" style="padding: 40px 20px; text-align: center; color: #64748b;">
                <div style="display: flex; flex-direction: column; align-items: center; gap: 8px;">
                  <i data-lucide="history" style="width: 30px; height: 30px; color: #475569;"></i>
                  <div style="font-size: 0.88rem; font-weight: 600; color: #e2e8f0;">Tidak ada riwayat penginputan yang cocok</div>
                  <div style="font-size: 0.78rem; color: #64748b;">Silakan sesuaikan filter atau tekan Reset Filter.</div>
                </div>
              </td>
            </tr>
          }
          else
          {
            int idx = 1;
            foreach (var rec in Model.Records)
            {
              string subRole = !string.IsNullOrEmpty(rec.CreatedByRole) ? rec.CreatedByRole : "karyawan";
              string subPlant = !string.IsNullOrEmpty(rec.CreatedByPlant) ? rec.CreatedByPlant : rec.Plant;
              var plantStyle = getPlantBadgeStyle(rec.Plant);

              <tr
                style="border-bottom: 1px solid rgba(255, 255, 255, 0.04); background-color: @(idx % 2 == 1 ? "transparent" : "rgba(255, 255, 255, 0.015)"); transition: background 0.12s ease;"
                onmouseenter="this.style.backgroundColor='rgba(255, 255, 255, 0.04)';"
                onmouseleave="this.style.backgroundColor='@(idx % 2 == 1 ? "transparent" : "rgba(255, 255, 255, 0.015)")';"
              >
                <!-- 1. WAKTU INPUT -->
                <td style="padding: 11px 10px; color: #cbd5e1; font-family: 'JetBrains Mono', monospace; font-size: 0.82rem; white-space: nowrap;">
                  @rec.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")
                </td>

                <!-- 2. ROLE PENGINPUT -->
                <td style="padding: 11px 10px; text-align: center;">
                  <span style="display: inline-block; padding: 2px 8px; border-radius: 4px; font-size: 0.72rem; font-weight: 700; text-transform: uppercase; background: @(subRole == "admin" ? "rgba(168, 85, 247, 0.15)" : "rgba(14, 165, 233, 0.15)"); color: @(subRole == "admin" ? "#c084fc" : "#38bdf8"); border: 1px solid @(subRole == "admin" ? "rgba(168, 85, 247, 0.35)" : "rgba(56, 189, 248, 0.35)");">
                    @(subRole == "admin" ? "Admin" : "Karyawan")
                  </span>
                </td>

                <!-- 3. PLANT (PENGINPUT) -->
                <td style="padding: 11px 10px; color: #e2e8f0; font-weight: 500;">
                  @subPlant
                </td>

                <!-- 4. NAMA KARYAWAN -->
                <td style="padding: 11px 10px; color: #f8fafc; font-weight: 600;">
                  @rec.UserName
                </td>

                <!-- 5. NPK -->
                <td style="padding: 11px 10px; text-align: center; color: #38bdf8; font-family: 'JetBrains Mono', monospace; font-weight: 600;">
                  @rec.UserNpk
                </td>

                <!-- 6. PLANT KARYAWAN -->
                <td style="padding: 11px 10px;">
                  <span style="font-size: 0.74rem; padding: 2px 7px; border-radius: 4px; background: @plantStyle.bg; color: @plantStyle.text; border: @plantStyle.border; font-weight: 600;">
                    @rec.Plant
                  </span>
                </td>

                <!-- 7. SHIFT -->
                <td style="padding: 11px 10px; text-align: center; color: #cbd5e1; font-weight: 500;">
                  @rec.ShiftName
                </td>

                <!-- 8. TANGGAL LEMBUR -->
                <td style="padding: 11px 10px; text-align: center; color: #cbd5e1; font-family: 'JetBrains Mono', monospace; font-size: 0.82rem; white-space: nowrap;">
                  @rec.WorkDate.ToString("yyyy-MM-dd")
                </td>

                <!-- 9. JAM LEMBUR -->
                <td style="padding: 11px 10px; text-align: right; color: #f8fafc; font-weight: 700; font-family: 'JetBrains Mono', monospace;">
                  @rec.JamOvertime.ToString("N1")
                </td>

                <!-- 10. TOTAL TUL -->
                <td style="padding: 11px 10px; text-align: right; color: #34d399; font-weight: 800; font-family: 'JetBrains Mono', monospace;">
                  @rec.TotalTul.ToString("N1")
                </td>
              </tr>
              idx++;
            }
          }
        </tbody>
      </table>
    </div>
  </div>

</div>

@section Scripts {
<script>
  function updateRiwayatLiveClock() {
    var now = new Date();
    var months = ['Jan', 'Feb', 'Mar', 'Apr', 'Mei', 'Jun', 'Jul', 'Agu', 'Sep', 'Okt', 'Nov', 'Des'];
    var d = String(now.getDate()).padStart(2, '0');
    var m = months[now.getMonth()];
    var y = now.getFullYear();
    var h = String(now.getHours()).padStart(2, '0');
    var min = String(now.getMinutes()).padStart(2, '0');
    var s = String(now.getSeconds()).padStart(2, '0');
    var el = document.getElementById('riwayatLiveClock');
    if (el) el.innerText = d + ' ' + m + ' ' + y + '  ' + h + ':' + min + ':' + s;
  }
  updateRiwayatLiveClock();
  setInterval(updateRiwayatLiveClock, 1000);
</script>
}
