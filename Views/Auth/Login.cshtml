@model LoginViewModel
@{
    Layout = null;
    bool isKaryawan = Model.ActiveTab != "admin";
}
<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Masuk Sistem - Q-WORKS</title>
  
  <!-- Offline Fonts (Inter, Montserrat, JetBrains Mono) -->
  <link rel="stylesheet" href="~/css/fonts.css" />
  <link rel="stylesheet" href="~/css/index.css" />
  <!-- Offline Lucide Icons -->
  <script src="~/lib/lucide/lucide.min.js"></script>
</head>
<body style="margin: 0; padding: 0; background-color: #020712; font-family: 'Inter', system-ui, -apple-system, sans-serif;">

<div style="min-height: 100vh; width: 100vw; background: radial-gradient(circle at 50% 30%, #0c2146 0%, #051124 55%, #020712 100%); display: flex; align-items: center; justify-content: center; padding: 32px 20px; box-sizing: border-box;">
  <!-- Login Card -->
  <div style="width: 100%; max-width: 480px; background: rgba(9, 22, 46, 0.94); backdrop-filter: blur(24px); -webkit-backdrop-filter: blur(24px); border: 1px solid rgba(56, 189, 248, 0.28); border-radius: 22px; box-shadow: 0 24px 60px rgba(0, 0, 0, 0.65), 0 0 36px rgba(2, 132, 199, 0.15); overflow: hidden;">
    
    <!-- Header -->
    <div style="padding: 38px 32px 24px; text-align: center; display: flex; flex-direction: column; align-items: center;">
      <!-- Logo Emblem -->
      <div style="width: 64px; height: 64px; border-radius: 16px; background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%); border: 2px solid rgba(56, 189, 248, 0.6); display: flex; align-items: center; justify-content: center; box-shadow: 0 10px 24px rgba(2, 132, 199, 0.4); margin-bottom: 16px;">
        <span style="font-size: 2.2rem; font-weight: 900; color: #ffffff; font-family: 'Montserrat', sans-serif; line-height: 1;">
          Q
        </span>
      </div>

      <h1 style="margin: 0; font-size: 1.75rem; font-weight: 800; color: #f8fafc; letter-spacing: 0.04em;">
        Q-WORKS
      </h1>
      <p style="margin: 6px 0 0; font-size: 0.92rem; color: #93c5fd; font-weight: 500;">
        Quality Control & Overtime System
      </p>
    </div>

    <!-- Role Tab Switcher -->
    <div style="margin: 0 32px 24px; padding: 5px; background: rgba(5, 14, 30, 0.88); border-radius: 12px; border: 1px solid rgba(56, 189, 248, 0.2); display: grid; grid-template-columns: 1fr 1fr; gap: 6px;">
      <button
        type="button"
        id="tabKaryawanBtn"
        onclick="switchLoginTab('karyawan');"
        style="padding: 12px 18px; border-radius: 8px; border: none; background: @(isKaryawan ? "linear-gradient(135deg, #0284c7 0%, #0369a1 100%)" : "transparent"); color: @(isKaryawan ? "#ffffff" : "#8ca8cf"); font-size: 0.95rem; font-weight: 700; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 8px; transition: all 0.15s ease;">
        <i data-lucide="user" style="width: 18px; height: 18px;"></i>
        <span>Karyawan Quality</span>
      </button>

      <button
        type="button"
        id="tabAdminBtn"
        onclick="switchLoginTab('admin');"
        style="padding: 12px 18px; border-radius: 8px; border: none; background: @(!isKaryawan ? "linear-gradient(135deg, #0284c7 0%, #0369a1 100%)" : "transparent"); color: @(!isKaryawan ? "#ffffff" : "#8ca8cf"); font-size: 0.95rem; font-weight: 700; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 8px; transition: all 0.15s ease;">
        <i data-lucide="shield-check" style="width: 18px; height: 18px;"></i>
        <span>Admin</span>
      </button>
    </div>

    <!-- Error Alert -->
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div style="margin: 0 32px 20px; padding: 11px 16px; background: rgba(239, 68, 68, 0.14); border: 1px solid rgba(239, 68, 68, 0.4); border-radius: 10px; color: #fca5a5; font-size: 0.88rem; display: flex; align-items: center; gap: 10px;">
          <i data-lucide="alert-circle" style="color: #ef4444; width: 18px; height: 18px; flex-shrink: 0;"></i>
          <span>@Model.ErrorMessage</span>
        </div>
    }

    <!-- Form Container -->
    <div style="padding: 0 32px 34px;">
      
      <!-- TAB 1: KARYAWAN -->
      <form id="formKaryawan" method="post" action="/Auth/LoginKaryawan" style="display: @(isKaryawan ? "flex" : "none"); flex-direction: column; gap: 18px;">
        @Html.AntiForgeryToken()
        <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />

        <div>
          <label style="display: block; font-size: 0.88rem; font-weight: 700; color: #94a3b8; marginBottom: 7px;">
            NPK
          </label>
          <div style="position: relative;">
            <i data-lucide="id-card" style="position: absolute; left: 14px; top: 14px; color: #38bdf8; width: 19px; height: 19px;"></i>
            <input
              type="text"
              name="KaryawanNpk"
              id="karyawanNpkInput"
              value="@Model.KaryawanNpk"
              placeholder="Contoh: 1747"
              style="width: 100%; height: 48px; padding: 12px 16px 12px 44px; background: rgba(5, 14, 30, 0.95); border: 1px solid rgba(56, 189, 248, 0.35); border-radius: 10px; color: #ffffff; font-size: 0.98rem; font-family: 'JetBrains Mono', monospace; outline: none; box-sizing: border-box;"
              required
              autocomplete="off"
            />
          </div>
        </div>

        <div>
          <label style="display: block; font-size: 0.88rem; font-weight: 700; color: #94a3b8; marginBottom: 7px;">
            Nama Karyawan
          </label>
          <div style="position: relative;">
            <i data-lucide="user" style="position: absolute; left: 14px; top: 14px; color: #38bdf8; width: 19px; height: 19px;"></i>
            <input
              type="text"
              name="KaryawanNama"
              id="karyawanNamaInput"
              value="@Model.KaryawanNama"
              placeholder="Nama lengkap"
              style="width: 100%; height: 48px; padding: 12px 16px 12px 44px; background: rgba(5, 14, 30, 0.95); border: 1px solid rgba(56, 189, 248, 0.35); border-radius: 10px; color: #ffffff; font-size: 0.98rem; outline: none; box-sizing: border-box;"
              required
            />
          </div>
        </div>

        <button
          type="submit"
          style="margin-top: 6px; height: 50px; padding: 13px 20px; border-radius: 10px; background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%); border: none; color: #ffffff; font-size: 1rem; font-weight: 700; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 10px; box-shadow: 0 4px 16px rgba(2, 132, 199, 0.35); transition: all 0.2s ease;">
          <span>Masuk sebagai Karyawan</span>
          <i data-lucide="arrow-right" style="width: 18px; height: 18px;"></i>
        </button>

        <div style="margin-top: 10px; text-align: center; font-size: 0.78rem; color: #64748b;">
          Akses terbatas pada plant kerja masing-masing (Hose, Molded, RVI, dll)
        </div>
      </form>

      <!-- TAB 2: ADMIN -->
      <form id="formAdmin" method="post" action="/Auth/LoginAdmin" style="display: @(!isKaryawan ? "flex" : "none"); flex-direction: column; gap: 18px;">
        @Html.AntiForgeryToken()
        <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />

        <div>
          <label style="display: block; font-size: 0.88rem; font-weight: 700; color: #94a3b8; marginBottom: 7px;">
            Username Admin
          </label>
          <div style="position: relative;">
            <i data-lucide="user" style="position: absolute; left: 14px; top: 14px; color: #38bdf8; width: 19px; height: 19px;"></i>
            <input
              type="text"
              name="AdminUsername"
              id="adminUsernameInput"
              value=""
              placeholder="Username admin"
              autocomplete="off"
              style="width: 100%; height: 48px; padding: 12px 16px 12px 44px; background: rgba(5, 14, 30, 0.95); border: 1px solid rgba(56, 189, 248, 0.35); border-radius: 10px; color: #ffffff; font-size: 0.98rem; outline: none; box-sizing: border-box;"
              required
            />
          </div>
        </div>

        <div>
          <label style="display: block; font-size: 0.88rem; font-weight: 700; color: #94a3b8; marginBottom: 7px;">
            Password Admin
          </label>
          <div style="position: relative;">
            <i data-lucide="lock" style="position: absolute; left: 14px; top: 14px; color: #38bdf8; width: 19px; height: 19px;"></i>
            <input
              type="password"
              name="AdminPassword"
              id="adminPasswordInput"
              value=""
              placeholder="Password admin"
              autocomplete="new-password"
              style="width: 100%; height: 48px; padding: 12px 44px 12px 44px; background: rgba(5, 14, 30, 0.95); border: 1px solid rgba(56, 189, 248, 0.35); border-radius: 10px; color: #ffffff; font-size: 0.98rem; outline: none; box-sizing: border-box;"
              required
            />
            <button
              type="button"
              onclick="toggleAdminPassword();"
              style="position: absolute; right: 14px; top: 14px; background: transparent; border: none; color: #64748b; cursor: pointer; padding: 0;">
              <i data-lucide="eye" id="eyeIcon" style="width: 18px; height: 18px;"></i>
            </button>
          </div>
        </div>

        <button
          type="submit"
          style="margin-top: 6px; height: 50px; padding: 13px 20px; border-radius: 10px; background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%); border: none; color: #ffffff; font-size: 1rem; font-weight: 700; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 10px; box-shadow: 0 4px 16px rgba(2, 132, 199, 0.35); transition: all 0.2s ease;">
          <i data-lucide="shield-check" style="width: 18px; height: 18px;"></i>
          <span>Masuk sebagai Admin</span>
        </button>

        <div style="margin-top: 10px; text-align: center; font-size: 0.78rem; color: #64748b;">
          Akses penuh (All Plants, Edit/Hapus Data, Master Pekerja, Riwayat Penginput)
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  function switchLoginTab(tab) {
    var isKaryawan = tab === 'karyawan';
    document.getElementById('formKaryawan').style.display = isKaryawan ? 'flex' : 'none';
    document.getElementById('formAdmin').style.display = !isKaryawan ? 'flex' : 'none';

    var btnK = document.getElementById('tabKaryawanBtn');
    var btnA = document.getElementById('tabAdminBtn');

    if (isKaryawan) {
      btnK.style.background = 'linear-gradient(135deg, #0284c7 0%, #0369a1 100%)';
      btnK.style.color = '#ffffff';
      btnA.style.background = 'transparent';
      btnA.style.color = '#8ca8cf';
    } else {
      btnA.style.background = 'linear-gradient(135deg, #0284c7 0%, #0369a1 100%)';
      btnA.style.color = '#ffffff';
      btnK.style.background = 'transparent';
      btnK.style.color = '#8ca8cf';
    }
  }

  function toggleAdminPassword() {
    var pass = document.getElementById('adminPasswordInput');
    if (pass.type === 'password') {
      pass.type = 'text';
    } else {
      pass.type = 'password';
    }
  }

  // Identifikasi NPK Karyawan hanya jika NPK lengkap cocok sepenuhnya di Master Pekerja
  var npkInput = document.getElementById('karyawanNpkInput');
  var namaInput = document.getElementById('karyawanNamaInput');
  if (npkInput) {
    npkInput.addEventListener('change', function() {
      var val = npkInput.value.trim();
      if (val.length > 0) {
        fetch('/Auth/LookupNpk?npk=' + encodeURIComponent(val))
          .then(function(res) { return res.json(); })
          .then(function(data) {
            if (data && data.success && data.name) {
              namaInput.value = data.name;
            } else {
              namaInput.value = '';
            }
          })
          .catch(function() {
            namaInput.value = '';
          });
      } else {
        namaInput.value = '';
      }
    });
  }

  document.addEventListener('DOMContentLoaded', function() {
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }
  });
</script>
</body>
</html>
